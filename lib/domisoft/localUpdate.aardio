    // 服务器标识会保存到本地，不直接从配置文件执行任意路径。
    var servers = {
        shanghai = {
            name = "Shanghai Office";
            dir = "\\ccnsia1a\separts\Admin\Addons\update";
        };
        qingdao = {
            name = "Qingdao Office";
