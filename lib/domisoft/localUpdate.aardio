    // 需要从服务器 update 上一层目录（..\）自动同步到本地 EXE 同级的文件夹列表
    // 后续如需增加其它文件夹（例如 "res", "plugins" 等），直接在此数组中添加名称即可
    var syncFolderNames = [
        "lib",
        "ext"
    ];

    // 独立于 TBM.ini，正常更新不会覆盖。
    var configFileName = "TBM.update.json";

    // 判断 EXE 是否位于 UNC 共享或映射网络盘。
    var isNetworkPath = function(path){
        if(..string.left(path,2) === "\\"){
            return true;
        }

        var rootPath = ..string.left(path,3);

        return ::Kernel32.GetDriveTypeW(rootPath)
            == 4/*_DRIVE_REMOTE*/;
    }

    // 静默创建桌面快捷方式，如果已存在则按新路径重新创建
    var ensureDesktopShortcut = function(targetPath){
        var desktopDir = ..io.getSpecial(0/*_CSIDL_DESKTOP*/);
        var lnkPath = ..io.joinpath(desktopDir, "TBM.lnk");
        if(..io.exist(lnkPath)){
            ..io.remove(lnkPath);
        }
        lnkPath = ..io.joinpath(desktopDir, "SE_TBM.lnk");
        if(..io.exist(lnkPath)){
            ..io.remove(lnkPath);
        }
        var lnk = ..fsys.lnk();
        lnk.filename = "SE_TBM.lnk";
        lnk.path = targetPath;
        lnk.workDir = ..io.splitpath(targetPath).dir;
        lnk.description = "domisoft SE_TBM tool";
        lnk.setIcon(targetPath, 0);
        lnk.pinToDesktop(true);
    }

