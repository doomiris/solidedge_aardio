    */
    var selectServer = function(winform, defaultTargetDir){
        
        var targetDir = defaultTargetDir;
        var targetPath = ..io.joinpath(targetDir, "SE_TBM.exe");
        var isInstall = (targetDir != null);
        var dlgH = isInstall ? 265 : 195;

        var dlg = ..win.form(
            text = isInstall ? "安装 TBM 到本地硬盘" : "选择 TBM 更新服务器";
            right = 490; bottom = dlgH;
            border = "dialog frame"; max = false; min = false;
            parent = winform; bgcolor = 0xFFFFFF
        );

        var buildPromptText = function(){
            var prefix = "";
            if(targetDir){
                prefix = '当前程序从网络共享启动，必须先安装到本地硬盘才能运行。\r\n'
                    ++ '安装路径：' ++ ..io.joinpath(targetDir, "SE_TBM.exe") ++ '\r\n'
                    ++ '（如果本地 TBM 正在运行，请先关闭它）\r\n\r\n';
            }
            return prefix
                ++ '请选择 TBM 的安装及后续更新服务器：\r\n\r\n'
                ++ '【Shanghai】' ++ servers.shanghai.dir ++ '\r\n'
                ++ '【Qingdao】 ' ++ servers.qingdao.dir ++ '\r\n\r\n'
                ++ '所选服务器会自动保存，后续更新使用同一服务器。';
        }

        // 只保留选择服务器与更改目录相关的控件
        dlg.add(
            lblIcon = {
                cls="plus";left=20;top=18;right=56;bottom=54;
                color=0xD47800;
                font=LOGFONT(h=-28;name='FontAwesome');
                iconText='\uF05A';valign="top";z=1
            };
            lblPrompt = {
                cls="static";text=buildPromptText();
                left=62;top=20;right=470;bottom=dlgH - 60;
                color=0x333333;font=LOGFONT(h=-13);transparent=1;z=2
            };
            btnBrowse = {
                cls="plus";text="更改目录...";
                left=20;top=dlgH - 48;right=135;bottom=dlgH - 14;
                align="left";textPadding={left=32};
                iconText='\uF07C';
                iconStyle={align="left";font=LOGFONT(h=-14;name='FontAwesome');padding={left=12}};
                bgcolor=0xF0F0F0;color=0x333333;
                border={radius=4;color=0xCCCCCC;width=1};
                font=LOGFONT(h=-13); hide = !isInstall; notify=1;z=3
            };
            btnQingdao = {
                cls="plus";text="Qingdao";
                left=232;top=dlgH - 48;right=347;bottom=dlgH - 14;
                align="left";textPadding={left=34};
                iconText='\uF1AD';
                iconStyle={align="left";font=LOGFONT(h=-14;name='FontAwesome');padding={left=12}};
                bgcolor=0xD47800;color=0xFFFFFF;
                border={radius=4};font=LOGFONT(h=-13);notify=1;z=4
            };
            btnShanghai = {
                cls="plus";text="Shanghai";
                left=359;top=dlgH - 48;right=474;bottom=dlgH - 14;
                align="left";textPadding={left=34};
                iconText='\uF1AD';
                iconStyle={align="left";font=LOGFONT(h=-14;name='FontAwesome');padding={left=12}};
                bgcolor=0xD47800;color=0xFFFFFF;
                border={radius=4};font=LOGFONT(h=-13);notify=1;z=5
            }
            lblIcon = {
                cls="plus";left=24;top=22;right=64;bottom=62;
                color=0x2EA043;
                font=LOGFONT(h=-32;name='FontAwesome');
                iconText='\uF058';valign="top";z=1
            };

);

        var serverBtnSkin = {
            background = { default = 0xFF0078D4; hover = 0xFF1084D9; active = 0xFF005A9E };
            color = { default = 0xFFFFFFFF }
        };
        dlg.btnShanghai.skin(serverBtnSkin);
        dlg.btnQingdao.skin(serverBtnSkin);

        if(isInstall){
            dlg.btnBrowse.skin({
                background = { default = 0xFFF0F0F0; hover = 0xFFE0EEF9; active = 0xFFCDE4F7 };
                color = { default = 0xFF333333; hover = 0xFF0067B8; active = 0xFF004578 }
            });

            dlg.btnBrowse.oncommand = function(){
                var newDir = ..fsys.dlg.dir(targetDir, dlg, "请选择 TBM 本地安装目录");
                if(newDir){
