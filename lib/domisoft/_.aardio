//domisoft
var table = ..table;
var string = ..string;
var math = ..math;
var io = ..io;

var replace = string.replace;
var trim = string.trim;

math.isNumber = function(str){
	if type(str) == "number" return true;
	if type(str) !=="string" return false;
	return !!string.match(str, "^[+-]?\d+\.?\d*$") ; 
}
/*
math.toNumber = function(str){
	if !str return 0;
	if string.len(str)==0 return 0;
	else return (tonumber(str));
}
*/
math.toNumber = function(str){
    if(!str) return 0;
    // 将转换结果强制转为数值,失败则返回 0,确保排序比较不报错
    return tonumber(str) : 0;
}
table.toHTML = function(tab){
    var html = "<table border=1>";
    for (i = 1; #tab) {
        html += "<tr>";
        for (j = 1; #tab[i]) {
        	tab[i][[j]] := "";
            html += "<td nowrap>" + tab[i][j] + "</td>";
        }
        html += "</tr>";
    }
    html += "</table>";
    return html;
}
namespace domisoft;

clearExcelCorpse = function(){
	..thread.invoke( 
		function(){//清理异常的excel进程
			import com.excel;
			import process;
			import console;
			var excel = com.excel(false);
			if excel.Visible == false and excel.WorkBooks.Count==0 {
				var hwnd = excel.Application.hwnd;
				process.fromWindowHandle(hwnd).terminate();
			}
			excel = null;
		}
	)
}
CleanHiddenExcel = function(){
    // 线程环境是独立的，必须在线程内部重新导入用到的所有库
//            import console;
    import process;
    import win;
    import winex.mainWindows;

    //console.log("已接收到通知，正在后台线程执行 EXCEL 清理...");

    var count = 0;
    for processEntry in process.each("excel\.exe") {
        var pid = processEntry.th32ProcessID;
        var mainWindows = winex.mainWindows(pid);

        var isHidden = true;
        var hasChild = false;

        if(mainWindows){
            var hwnd = mainWindows.hwnd; 

            if( win.isVisible(hwnd) ){
                isHidden = false;
            }

            if( win.findEx(hwnd, 0) ){
                hasChild = true;
            }
        }

        if( isHidden && !hasChild ){
//                   console.log("检测到无显示且无子窗口的 EXCEL 进程 PID:", pid, "，正在清理...");

            var prcs = process(pid);
            if(prcs){
                prcs.terminate(); 
                prcs.free();      
//                      console.log("-> 进程结束成功！");
            }
            else {
//                      console.log("-> 结束进程失败，可能权限不足，请尝试以管理员身份运行。");
            }

            count++;
        }
    }

    if(count == 0){
//               console.log("未检测到符合条件的 EXCEL 进程");
    }
}

getComAppPath = function(keyword){
	import process;
	import process.cache; 
	//用下面的方法可以搜索运行或 AppPath 注册过的程序，找不到再查找快捷方式
	var appPath = process.cache.find(keyword);
	return appPath;
}
getRunningWorkSheet = function(workbookName,worksheetName){
	import com;
	var sht;
	for (i=1;5){
		com.enumRunning( 
			function(displayName,object){
					if com.GetTypeInfo(object) {
						if string.indexOf(com.GetTypeInfo(object).GetDocumentation().name,"_Workbook") {
							if !workbookName 
								sht = object.ActiveSheet ;							
							elseif string.endWith(displayName, workbookName, true) {
								if worksheetName
									sht = object.Sheets(worksheetName) : null; 
								else
									sht = object.ActiveSheet 
								return true; 
							}
						}
					}
			}
		)
		if !sht			sleep(500)
		else break;
	}
	return sht; 
}
stopExcelCutCopyMode = function(){
	import com;
	com.enumRunning( 
		function(displayName,object){
				if com.GetTypeInfo(object) 
					if ..string.indexOf(com.GetTypeInfo(object).GetDocumentation().name,"_Workbook")
						try{
							object.Application.CutCopyMode = false
						}
		}
	)
	return 1; 
}
taobaoURLsimple = function(url){
	import inet.url;
	import inet.urlpart;
	url = inet.url.decode(url);
	return url; 
	var turl = inet.url.split(url ); 
	var para = inet.urlpart.getQuery(url);
	var s = inet.url.splitParameters(para);	
	var n = inet.url.stringify(
		scheme = turl.scheme;
		host = turl.host;
		path = turl.path;
		extraInfo = {
			id = s.id;
		};
	)
	return string.trimright(n,"?"); 
}
getSelectedText = function(listCtrl){
	var t = {}
	for index, text in listCtrl.eachSelected()
		table.unshift(t, text);
	return t; 
}

copySelectedItem = function(ctrl){
		if !ctrl	ctrl = owner;
		var doNotCopyColumns = ctrl.doNotCopyColumns : [/* 防null报错 */];
		
		table.sort(doNotCopyColumns);
		//table.reverse(doNotCopyColumns);

        import win.clip;
        import win.clip.html;
        
        ..thread.invoke(stopExcelCutCopyMode);
        
		var selected = ctrl.selected;
		var sourceTab = ctrl.getTable(true);
		var fields = table.shift(sourceTab)
		var items = sourceTab;

		var selTab = [];
		if ctrl.copyWithHeaders
			table.push(selTab, fields); 
		for (i=1; #selected)
				table.push(selTab, items[selected[i]]);
				
		for (i=1; #selTab){
			for(j=1; #doNotCopyColumns)
				selTab[i][doNotCopyColumns[j]] = null;
			table.removeByValue(selTab[i], null);
			var cacheTab = [];
			for k, v in selTab[i] 
				table.push(cacheTab,v); //处理稀疏数组问题, 顺序有乱的情况?
			selTab[i] = cacheTab;
		};

		/* clip添加纯文本格式 */
        var txtTab = [];
        for (i=1; #selTab)
            table.push(txtTab, string.join(selTab[i], '\t'));
		win.clip.write(string.join(txtTab, '\r\n'));

		/* clip添加HTML格式 */
		var hTab = [];
        for (i=1; #selTab)
            table.push(hTab, selTab[i]);
        var html = table.toHTML(hTab);  
 		var cliphtml = win.clip.html();
        html = cliphtml.stringify(html);
		cliphtml.write(html,true,false);
		return hTab; 
}

