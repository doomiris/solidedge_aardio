formatWindowsFileName = function (nameStr) {
    if(!nameStr) return ""; 

    /*
    使用映射表一次性处理所有非法字符。
    模式串解释：
    - [ ... ]：表示字符类，匹配其中任意一个字符。
    - \/ 和 \\ ：匹配斜杠与反斜杠。
    - \: ：在模式匹配的 [] 内，冒号具有特殊语义（匹配多字节字符），表示普通冒号需转义。
    - \* 和 \? ：在模式匹配中是量词，表示字面值需转义。
    - \" ：匹配双引号s。
    - \r \n ：匹配回车换行。
*/
var result = string.replace(nameStr, `[\/\\\:\*\?\"\<\>\|\r\n]`, {
        ["\"] = "＼";
        ["/"] = "／";
        [":"] = "：";
        ["*"] = "＊";
        ["?"] = "？";
        ['"'] = "“";
        ["<"] = "＜";
        [">"] = "＞";
        ["|"] = "｜";
        ['\r'] = " ";
        ['\n'] = " "
    }); 
    return string.trim(result);
};

setColumnWidth = function(lv, widthTab){
	var count = math.max(lv.columnCount, #widthTab)
	for (i=1; count)
		if i <= lv.columnCount
			lv.setColumn({
				cx = widthTab[i];
				fmt = (widthTab[i] <= 100) ? 0x2 /*_LVCFMT_CENTER*/ : 0x0 /*_LVCFMT_LEFT*/
			}, i);
	return true; 
}
getFileDate = function(filename, formatString = "%Y/%m/%d %H:%M:%S"){
	if !io.exist(filename) return null; 
	import fsys.file;
	var file = fsys.file(filename);
	if !file return null; 
	var d = file.getTime().write.local();
	file.close();
	file = null
	if formatString d = ..time(d, formatString);
	return d; 
}
sendFileTo = function(fullname, dest){
	
}
listColSort = function(column, desc){
    var fields = owner.source ? owner.source.fields;
    if(!fields) return;

    var name = fields[column];
    if(!name) return;

    // 1. 获取当前界面正在显示的数据（即筛选后的结果）
    var currentData = owner.getTable(fields); 

    // 定义一个内部函数用于提取可比较的值
    var getSortableValue = function(val){
        if( val === null || val === "" ) return ""; // 空值排在最前/最后

        // 如果已经是数值或看起来像数字
        if( type(val) == "number" || ..math.isNumber(val) ){
            return tonumber(val);
        }

        // 尝试识别日期格式 (例如 2023/01/01 或 2023-01-01)
        if( type(val) == "string" && ..string.match(val,"^\d({2,4})[\/\-\.]\d({1,2})[\/\-\.]\d{1,2}") ){
            var tm = ..time(val); // 尝试解析
            if(tm) return tonumber(tm); // 返回时间戳数值用于比较
        }

        // 否则作为字符串处理（统一转小写以实现不区分大小写排序）
        return ..string.lower(tostring(val));
    };

    // 提取统一的排序比较函数
    var compareFunc = function(next) {
        var a = getSortableValue(owner[name]);
        var b = getSortableValue(next[name]);

        // 如果类型不同（例如数字和字符串混在一起）, 强制转为字符串比较, 防止报错
        if( type(a) != type(b) ){
            a = tostring(a);
            b = tostring(b);
        }

        if(desc) return a > b;
        return a < b;
    };

    // 2. 对当前显示的数据进行排序
    ..table.sort(currentData, compareFunc);

    // 3. 同时对后台全量数据源排序（这样在下次筛选、或重置时能保持同样的顺序）
    if(owner.source){
        ..table.sort(owner.source, compareFunc);
    }

    // 4. 将排序后的当前筛选结果重新写回列表视图
    owner.setTable(currentData);
    return true; 
};
getUserFolder = function(corp){

	corp := "CCR"

	var root_path = "HKEY_CURRENT_USER\SOFTWARE\Microsoft\OneDrive\Accounts\"	
	import win.reg
	var root = win.reg(root_path, true);
	var rootKeys = root.keys();
	var businessKeys = []
	for(i=1; #rootKeys)
		if string.startsWith(rootKeys[i], "business", true)
			table.push(businessKeys, rootKeys[i])
	var getValueInKey = function(keyName, valueName){
		import win.reg
		var wkey = win.reg(keyName, true);
		return wkey.queryValue(valueName); 
	}
	for (i=1; #businessKeys){
		if getValueInKey(root_path ++businessKeys[i], "DisplayName" ) == corp {
			var UserFolder = getValueInKey(root_path ++ businessKeys[i], "UserFolder" );
			if UserFolder
				return	string.replace(UserFolder,"@OneDrive - ","");
		}
	}
	var OneDriveCommercial = string.getenv("OneDriveCommercial");
	if OneDriveCommercial
		return string.replace( OneDriveCommercial ,"@OneDrive - ","");
	return null; 
}
envFix = function(str){
	if !str return str; 
	var outStr = str;
	var matches = string.matches(str, "%%%");
	if !matches or !#matches return str; 
	for k, v in matches {
		if #v
			var envVar = getUserFolder(string.trim(v[1],"%"));
		if envVar 
			outStr = string.replace(outStr, "@"+v[1], envVar);
	}
	//outStr = string.replace(outStr,"@OneDrive - ","");	/*bugfix*/
	return outStr;
}
isWorkingHour = function(startHour = 8, endHour = 18){
	var currentHour = ..time.now().hour;
/*
# 判断currentHour 是否在 startHour 和 endHour 区间内, 返回 true 或 false
*/
	if (startHour <= endHour) {		// Same-day range (e.g., 8 to 18)
		return currentHour >= startHour and currentHour < endHour;
	} 
	else {		// Cross-day range (e.g., 22 to 6)
		return currentHour >= startHour or currentHour < endHour;
	}
}

refreshSAP = function(winform){
	import config;
	if !config.settings.keepRefreshSAPGUI return ; 
	..thread.invoke(
		function(winform){
			import domisoft;
			winform.setInterval( 
				function(){
					try{
						if !domisoft.isWorkingHour() return ; 
    					import SAP.vm;
    					var session = SAP.vm();
    					if !session	return ; 
    					if !session.busy{
							if session.isHomepage {
								session.refresh();
								//wform.edit.log(",");
							}
						}
						session = null;
						collectgarbage("collect");
					}
				}, 1000 * 5 * 60 /*注意毫秒转分钟*/)
		}, winform
	)	
}
getActiveAppName = function(){
	import win;
	import winex;
	import process;
    var hwnd = win.getForeground();
    if !hwnd return;
    
    var title = winex.getText(hwnd);
    if !title or !#title {
    		title = win.getText(win.getParentOwner(hwnd));
    	}
    var proc = process.fromWindowHandle(hwnd);
    var exePath;
    if proc
        exePath = proc.getPath();
     return title, exePath, hwnd; 
}

getTopSAPInstance = function(){
	import web.script;

	var topHwnd = win.find("SAP_FRONTEND_SESSION"); 
	if(!topHwnd) return;

	var vbsCode = /*
Function GetSessionNumberByHwnd(topHwndStr)
    GetSessionNumberByHwnd = 0
    On Error Resume Next
    Dim sapGuiAuto, app, conn, session, wnd
    Set sapGuiAuto = GetObject("SAPGUI")
    If sapGuiAuto Is Nothing Then Exit Function
    Set app = sapGuiAuto.GetScriptingEngine()
    If app Is Nothing Then Exit Function
    
    For Each conn In app.Children
        For Each session In conn.Children
            Set wnd = session.ActiveWindow
            If Not (wnd Is Nothing) Then
                ' 将句柄强制转为字符串比对, 避免 VBScript 出现长整型溢出错误
                If CStr(wnd.Handle) = CStr(topHwndStr) Then
                    GetSessionNumberByHwnd = session.Info.SessionNumber
                    Exit Function
                End If
            End If
        Next
    Next
End Function
	*/

	// 创建 VBScript 执行引擎
	var vbs = web.script("VBScript");
	vbs.AddCode(vbsCode);

	// 执行函数，将 aardio 的句柄数值转为字符串后传入
	var sessionNumber = vbs.script.GetSessionNumberByHwnd(tostring(topHwnd));
	vbs.reset()
	vbs = null
	collectgarbage("collect");
	if(sessionNumber && sessionNumber > 0){
		return sessionNumber - 1; 
	}
	//中途如果关闭了一个窗口会报错
}

/**intellisense(domisoft)
clearExcelCorpse( ) = 清理异常的excel进程
getComAppPath(keyword) = 查找com程序路径
getActiveAppName() = 返回上层app完整路径名
getSelectedText(listbox) = 返回选中的文本数组,listview返回首列
getRunningWorkSheet(workbookName,worksheetName) = 获取worksheet对象 不指定worksheetName时返回sheets(1)
taobaoURLsimple(taobaoUrl) = 简化taobao链接
ctrlC(translateAccelerator, doNotCopyColumns) = 用于listview.translateAccelerator赋值启用CTRL+C复制功能
readClipHcode() = 获取截图中的专用号
getContentFromHTTP(.(url, parseJson) = 获取网址内容
formatWindowsFileName(nameStr) = 替换Windows文件名非法字符为全角＼"／，．＜＞｜＊
setColumnWidth(listview, widthTable) = 设置列宽
copyTable(tab, selectedIndex) = 复制表格
getFileDate(filename, formatString) = 获取文件修改时间
envFix(str) = 查找并替换%组成的系统参数
end intellisense**/

