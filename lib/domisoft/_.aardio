copyTable = function(tab, selectedIndex){
		if !#tab return ; 
		select type(selectedIndex) {
			case "number" {selectedIndex = {selectedIndex}}
			case "table" {/*不处理*/}
			case "null" {
				selectedIndex = [];
				for (i=1;#tab) selectedIndex[i] = i;
			}
			else return ; 			
		} 
        import win.clip;
        import win.clip.html;
        var cliphtml = win.clip.html();

		/* clip添加纯文本格式 */
        var txtTab = [];
        for (i=1; #selectedIndex)
            table.push(txtTab,string.join(tab[selectedIndex[i]],'\t'));
		win.clip.write(string.join(txtTab,'\n'));		
		/* clip添加HTML格式 */
		var hTab = [];
        for (i=1; #selectedIndex)
            table.push(hTab, tab[selectedIndex[i]]);            
        var html = table.toHTML(hTab)
        html = cliphtml.stringify(html);
		cliphtml.write(html,true,false);
		return hTab; 
}
selectAll = function(ctrl){
	if !ctrl ctrl = owner
	var t = [];
	for (i=1; ctrl.count) table.push(t, i); 
	ctrl.selected = t; 
}

ctrlC = function(msg){
    var ctrl = ::GetKeyState(0x11/*_VK_CTRL*/);
    var vk = msg.wParam;    
    if( ( vk == 'C'# ) && ctrl ){
		copySelectedItem(owner);
        return true;
    }
    if( ( vk == 'A'# ) && ctrl ){
		selectAll(owner);
        return true;
    }
}


readClipHcode = function(){
    import win.clip;
    import dotNet.ocr;

    var hBmp = win.clip.readBitmap()
    if(!hBmp) return;

    var bmp = ..gdip.bitmap(hBmp);

    // ==========================================
    // 【关键步骤 1】图像 2 倍高质量双立方放大预处理
    // ==========================================
    var width = bmp.width * 2;
    var height = bmp.height * 2;
    var bmpBig = ..gdip.bitmap(width, height);
    var graphics = ..gdip.graphics(bmpBig);

    // 设置插值模式为高质量双立方（能使放大后的文字边缘平滑不失真）
    graphics.interpolationMode = 7/*_InterpolationModeHighQualityBicubic*/;
    graphics.drawImageRect(bmp, 0, 0, width, height);
    graphics.delete(); // 释放临时绘图画布
    bmp.delete();      // 释放原小图
    // ==========================================

    var ocr = dotNet.ocr();
    ocr.language = "en-US";
    var ocrRet = ocr.detectBitmap(bmpBig);

    // 【关键修复】放大后的临时图像和 GDI 句柄必须安全释放，防止 GDI 泄露
    bmpBig.delete();
    ::DeleteObject(hBmp); 

    var t = {};
    if(ocrRet){  
        for i, block in table.eachIndex(ocrRet.blocks){
            var s = string.upper(trim(block.text)); // 统一转大写处理
            if(!#s) continue;

            // 1. 过滤掉常见 OCR 杂质（如两侧多出来的单引号、空格、逗号等）
            s = string.replace(s, "[\s,']", ""); 

            // 2. 纠正首字符被误判为 11、1-1、8、I 等导致 H 丢失的问题
            // 用非捕获组匹配所有长得像 "H008" 的开头
            s = string.replace(s, "^<<11|1\-1|1\-\-1|8|I|L>008>", "H008");

            // 3. 如果前缀识别正确（或者符合特殊匹配），强制进入特定纠错
            if( string.startsWith(s, "H008") || string.startsWith(s, "008") ){

                // 如果漏了 H，补上 H
                if(string.startsWith(s, "008")) s = "H" ++ s;

                // 提取首字符 'H' 之后的部分单独处理（防止误伤首字母）
                var part2 = string.slice(s, 2);

                // 将后半部分中被误识别成英文的字符强行修复回数字
                part2 = string.replace(part2, "O", "0"); // 欧 -> 零
                part2 = string.replace(part2, "D", "0"); // D -> 零
                part2 = string.replace(part2, "U", "0"); // U -> 零
                part2 = string.replace(part2, "I", "1"); // I -> 一
                part2 = string.replace(part2, "L", "1"); // L -> 一
                part2 = string.replace(part2, "Z", "2"); // Z -> 二
                part2 = string.replace(part2, "S", "5"); // S -> 五
                part2 = string.replace(part2, "G", "9"); // G -> 九
                part2 = string.replace(part2, "B", "8"); // B -> 八
                part2 = string.replace(part2, "€", "6"); // 欧元符号 -> 六
                part2 = string.replace(part2, "T", "6"); // T -> 六
                part2 = string.replace(part2, "/", "7"); // 斜杠 -> 七

                s = "H" ++ part2;
            }

            // 4. 验证最终格式：只有符合 H + 10位数字（如 H0080859056）格式的才收录
           // if( string.match(s, "^H\d{10}$") ){
                table.push(t, s);
           // }
        }
    }
    return t; 
}
getContentFromHTTP = function(url, parseJson = false){
	import inet.http;
	var http = inet.http();
	var t = http.get(url);
	http.close();
	if !parseJson return t; 
	import web.json;
	return web.json.parse(t);
}
