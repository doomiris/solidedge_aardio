import config;
import quickTools;
if config.serverIndex.combobox {
	config.settings.cbb_serverIndex = config.serverIndex.combobox
	config.serverIndex.combobox = null;
}

winform.bindConfig( config.settings,{
	checkbox = "checked";
	edit = "text";
	combobox = "selIndex";
/*

	radiobutton = "checked";
	combobox = "selIndex";
	plus ={
		["^chk"] = "checked";
		["^edit"] = "text";
	};
*/
	
} );

winform.button.oncommand = function(id,event){
	var oldKey = config.setbm.wakeUpKey; 
	config.setbm.wakeUpKey = winform.hotkey.value;
	
/*
	config.qtip.pdfLib = winform.edit.text;
	config.qtip.qhcLib = winform.edit2.text;
	config.qtip.cabinetModelServer = winform.edit3.text;
	config.qtip.templateLib = winform.edit4.text;
*/

	config.setbm.save();
	config.settings.save();
	config.qtip.save();
	
	if oldKey !== winform.hotkey.value
		winform.msgInfo("唤起快捷键修改后需要重启TBM程序", 1000);
	if mainForm
		mainForm.custom.loadForm("\forms\main\frmPage3.aardio");
	if !winform.parent
		winform.close();
}


import fsys.dlg;
import JSON;

winform.cbb_serverIndex.onSelChange = function(){ 
    var serverName;
    select(owner.selIndex) {
        case 1 {
            config.dbServer.path = "\\ccnsia1a\separts\Admin\SAP\db\";
            serverName = "shanghai";
        }
        case 2 {
            config.dbServer.path = "\\CCNQIA05\temp-\LGP\_db\";
            serverName = "qingdao";
        }
        case 3 {
            import fsys.dlg.dir;
            var path = fsys.dlg.dir(,winform,"指定DB所在目录");
            if !path return ; 
            config.dbServer.path = io.joinpath(path,"\");
            serverName = "local"; //本地磁盘对应的值，可按需改成 "localdisk" 等
        }
    }
    config.dbServer.save();

    //更新 TBM.update.json（与 EXE 同目录）
    if( serverName ){
        var updateInfo = JSON.load("~\TBM.update.json") : {};
        updateInfo.server = serverName;
        JSON.save("~\TBM.update.json",updateInfo);
    }

    winform.static3.refresh();
}


winform.static3.refresh = function(id,event){
	owner.text = thread.invokeAndWait(quickTools.getMainDbModifiedDate);
}

winform.static3.oncommand = winform.static3.refresh;
winform.static3.refresh();



winform.hotkey.value = config.setbm.wakeUpKey;

winform.group();



import win.ui.grid;

winform.listview.insertColumn("AutoStart",-1)
var grid = win.ui.grid(winform.listview)
for k, v in config.autoStart
	if type(v)=="table"
		winform.listview.addItem(v.text)

import win.ui.menu;
import win.dlg.message;
grid.onRightClick = function(item,subItem,nmListView){
	var popm = win.ui.popmenu(winform)
	popm.add("删除此启动项",function(){
		var asItemName = winform.listview.getItemText(item);
		for k, v in config.autoStart {
			if type(v)!=="table" continue;
			if 	v.text == asItemName {
				v = null;
				winform.listview.delItem(item)
			}
		}
		config.autoStart.save();
		winform.msgInfo("已删除",500);
	})
	popm.popup()
}

// 在 edit 内部创建密码显隐按钮
var setupPasswordReveal = function(editCtrl){

    // 允许 edit 响应内部 addCtrl 子控件命令
    editCtrl.translateCommand();

	var btnEye = editCtrl.addCtrl(
    	cls="plus";
    	checked=true; // 初始密码隐藏
    	width=20;
    	height=16;
    	marginTop=0.2;
    	marginRight=4;
    	iconText='\uF070';
    	iconStyle={
        	align="center";
        	valign="center";
        	font=LOGFONT(h=-14;name='FontAwesome');
    	};
	);
	
	btnEye.skin({
    	color={
        	default=0xC0888888;
        	hover=0xFF0078D4;
        	active=0xFF005A9E;
    	};
    	checked={
        	iconText='\uF06E';
        	color={
            	default=0xFF0078D4;
        	};
    	};
	});
	
	btnEye.onMouseClick = function(){
    	// checked 是点击后的状态：
    	// false = 显示明文，true = 隐藏密码
    	editCtrl.passwordChar = owner.checked ? "*" : null;
	};

    return btnEye;
};

// 两个密码输入框分别添加内嵌按钮
setupPasswordReveal(winform.edit_SAP_pw);
setupPasswordReveal(winform.edit_SAP_pw2);


