winform_qtip.add(
bkplus1={cls="plus";text="过滤";left=24;top=8;right=64;bottom=40;bgcolor=0xC0C0C0;dl=1;dt=1;z=10};
bkplus2={cls="plus";text="SAP";left=64;top=8;right=104;bottom=40;bgcolor=0xC0C0C0;border={bottom=5;color=0x800000};dl=1;dt=1;notify=1;z=6};
bkplus3={cls="plus";text="详细";left=104;top=8;right=144;bottom=40;bgcolor=0xC0C0C0;dl=1;dt=1;notify=1;z=8};
bkplus4={cls="plus";text="图纸";left=144;top=8;right=184;bottom=40;bgcolor=0xC0C0C0;dl=1;dt=1;z=7};
bkplus5={cls="plus";text="版次";left=184;top=8;right=224;bottom=40;bgcolor=0xC0C0C0;dl=1;dt=1;z=9};
button={cls="button";text='\uF002  查询SAP';left=520;top=8;right=619;bottom=38;default=1;dr=1;dt=1;font=LOGFONT(name='FontAwesome');tabstop=1;z=2};
button2={cls="button";text='\uF053';left=0;top=8;right=24;bottom=40;color=0x808080;dl=1;dt=1;flat=1;font=LOGFONT(h=-13;name='FontAwesome');z=12};
buttonD={cls="button";text='\uF142';left=235;top=10;right=249;bottom=40;color=0x808080;dl=1;dt=1;flat=1;font=LOGFONT(h=-13;name='FontAwesome');z=3};
custom={cls="custom";left=0;top=56;right=640;bottom=504;ah=1;aw=1;bgcolor=0xFFFFFF;db=1;dl=1;dr=1;dt=1;edge=1;z=1};
edit2={cls="edit";left=56;top=12;right=176;bottom=36;aw=1;dl=1;dt=1;font=LOGFONT(h=-13);hide=1;readonly=1;z=4};
editUser3={cls="edit";left=256;top=8;right=520;bottom=47;autohscroll=false;aw=1;dl=1;dr=1;dt=1;edge=1;multiline=1;vscroll=1;z=5};
splitter={cls="splitter";left=0;top=48;right=640;bottom=56;aw=1;frame=1;horz=1;z=11}
);
/*}}*/
import win.ui.tabs;
import win.ui.tooltip;
import color;
import config;
import domisoft;
import win.inputBox;
import thread.command;

// 创建线程命令监听器，统一响应后台任务
var cmdListener = thread.command();

// 监听工作线程完成事件
cmdListener.onSearchComplete = function(){
    winform_qtip.button.disabledText = null;
    winform_qtip.publish("status2","刷新数据库日期");
}

/*拆分条{{*/
winform_qtip.splitter.split(winform_qtip.editUser3, winform_qtip.custom);
winform_qtip.splitter.ltMin = 32;
winform_qtip.splitter.rbMin = 96;
/*}}*/

/*TABS{{*/
winform_qtip.qtbs = win.ui.tabs(
    winform_qtip.bkplus1,
    winform_qtip.bkplus2,
    winform_qtip.bkplus3,
    winform_qtip.bkplus4,
    winform_qtip.bkplus5
);

winform_qtip.qtbs.skin({
    foreground={
        active=0xFFFFFFFF;
        default=0x00FFFFFF;
        hover=0x38FFFFFF
    };
    color={
        default=0xFF000000; 
    };
    checked={
        foreground={default=0xFF00BBFF;}; 
        color={default=0xFF002E59;};
    }
})

var qfName = {
    [1] = "\forms\main\qtip_filter.aardio";
    [2] = "\forms\main\qtip_list.aardio";
    [3] = "\forms\main\sap_search.aardio";
    [4] = "\forms\main\drawing_search.aardio";
    [5] = "\forms\main\check_QHC_Release.aardio";
}
for k,v in qfName
    winform_qtip.qtbs.loadForm(k, v);

winform_qtip.qtbs.forms[1].publish("preload") 
winform_qtip.qtbs.goto = function(index){
    owner.selIndex = index;
}
winform_qtip.qtbs.goto(2); 

winform_qtip.qtbs.open = function(selIndex,pcode){
    owner.goto(selIndex);
    owner.forms[selIndex].qtip_search(pcode);
}
/*}}*/

/*搜索按钮{{*/
winform_qtip.button.oncommand = function(id,event){
    if (event !== 0/*_BN_CLICKED*/) return ;

    var txt = winform_qtip.editUser3.text;
    if(!#txt) return;

    // 显示加载动画并禁用按钮
    winform_qtip.button.disabledText = {'\uF254';'\uF251';'\uF252';'\uF253';'\uF250'};
    winform_qtip.qtbs.goto(2); 

    // 执行搜索
    winform_qtip.qtbs.forms[2].qtip_search(txt); 
}
/*}}*/

/*弹出历史记录菜单{{*/
winform_qtip.historyMenu = {};
var createHistoryMenu = function(){
    winform_qtip.historyMenu = win.ui.popmenu(winform_qtip);
    winform_qtip.historyMenu.onMenuItemClick = function(id){
        winform_qtip.editUser3.text = winform_qtip.historyMenu.getString(id, 0);
        winform_qtip.editUser3.setFocus();
    }
	var addFav = function(){
    	var fav = config.qtip.fav;      
    	var favName = winform_qtip.inputBox("请为要收藏的清单命名:", "收藏");
    	if(!favName) return;
	
    	var exists = #table.filter(fav, lambda(v) favName == v[["title"]]);
    	if(exists && !win.msgboxTest("点击确认覆盖相同名称收藏", "覆盖确认")) return;
	
    	// 倒序安全删除同名项，防止稀疏数组
    	for(i=#fav; 1; -1){
        	if(fav[i][["title"]] == favName){
            	table.remove(fav, i);
        	}
    	}
	
    	table.push(fav, {
        	title = favName;
        	list = domisoft.getSelectedText(winform_qtip.qtbs.forms[2].listview);
    	});
    	config.qtip.save();     
	}

    winform_qtip.historyMenu.add("识别剪贴板图像", function(){
        var t = domisoft.readClipHcode();
        if t
            winform_qtip.editUser3.text = string.join(t,'\r\n');        
    });
    winform_qtip.historyMenu.add();
    var favTab = {
        [1] = "★ 收藏夹"; 
        [2] = { 
                [1] = {
                    "+ 添加到收藏夹...";
                    addFav;
                };
                [2] = {/* ---- */};
        }
    }; 

    var fav = config.qtip.fav;
    for (i=1; #fav) {
        if !fav[i] continue;
        table.push(favTab[2], { 
                fav[i]["title"];
                function(id){
                    var shift = ::GetKeyState(0x10/*_VK_SHIFT*/) & 0x8000;
                    var ctrl = ::GetKeyState(0x11/*_VK_CTRL*/) & 0x8000;

                    if !shift and !ctrl
                        winform_qtip.qtbs.forms[2].qtip_search(string.join(fav[i]["list"],";"));
                    if shift and !ctrl
                        if win.msgboxTest("确认删除此条收藏?","删除收藏"){
                            fav[i] = null;
                            winform_qtip.historyMenu.delete(id, 0/*_MF_BYCOMMAND*/)
                            config.qtip.save();
                        }
                    if !shift and ctrl
                        if win.msgboxTest("替换为当前选择的清单?","确认替换") {
                            fav[i]["list"] = domisoft.getSelectedText(winform_qtip.qtbs.forms[2].listview);
                            config.qtip.save();
                        }
                    if shift and ctrl {
                        var newFavName = winform_qtip.inputBox("请输入新名称", "修改名称", fav[i]["title"]);
                        if newFavName {
                            fav[i]["title"] = newFavName;
                            winform_qtip.historyMenu.setString(id, newFavName, 0/*_MF_BYCOMMAND*/);
                            config.qtip.save();
                        }
                    }
                }
        })
    }
    winform_qtip.historyMenu.addTable({favTab})
    winform_qtip.historyMenu.add();
    for (i=1; #config.qTipLog){
        if !config.qTipLog[i] continue;
        winform_qtip.historyMenu.add(
            text = config.qTipLog[i];
        );
    }
}

winform_qtip.buttonD.oncommand = function(id,event){
    createHistoryMenu();
    var x,y = win.getMessagePos(); 
    winform_qtip.historyMenu.popup(x,y,true)
}
/*}}*/

/*右键点击快速取消筛选{{*/
winform_qtip.bkplus1.onRightMouseUp = winform_qtip.qtbs.forms[1].syslink.onHyperlinkClick;
winform_qtip.qtbs.updateColor = function(btCtrl){
    var t = #winform_qtip.qtbs.forms[1].clSapType.selected + #winform_qtip.qtbs.forms[1].clUnit.selected + #winform_qtip.qtbs.forms[1].clOrderType.selected;
    btCtrl.border = t ? {top=5;color=-16711936} : null;
    btCtrl.redraw();
}
/*}}*/

/*后退按钮{{*/
winform_qtip.button2.oncommand = function(id,event){
    if (event == 0/*_BN_CLICKED*/)
        winform_qtip.qtbs.goto(2); 
}
/*}}*/

var tooltipCtrl = win.ui.tooltip( winform_qtip );
tooltipCtrl.addTool(winform_qtip.buttonD, `
查看搜索历史记录和清单收藏夹
> 创建清单时仅保存当前选择的物料, 无选择时保存整个清单
- 按住SHIFT+点击:删除记录/收藏
- 按住CTRL+点击:替换收藏内容为当前选择的清单
- 同时按住SHIFT+CTRL+点击:修改收藏名称
`)
import win;
win.hookMessage(
    function(msg){
        if( msg.message == 0x20C/*_WM_XBUTTONUP*/ ){
            var direction = ::HIWORD(msg.wParam) == 1 ? "back" : "forward";

            select(direction) {  
                case "back" { winform_qtip.qtbs.goto(2); }
                case "forward" { winform_qtip.qtbs.goto(1); }
            }
        }
    }
)

winform_qtip.show();
win.loopMessage();
return winform_qtip;
