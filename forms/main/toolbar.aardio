custom={cls="custom";text="自定义控件";left=-3;top=1;right=758;bottom=73;dl=1;dr=1;dt=1;z=1};
edit={cls="edit";left=2;top=77;right=441;bottom=98;autohscroll=false;autovscroll=false;dl=1;dt=1;z=3};
