//利用列表右侧的空白区域显示说明。
//只读文本框可以选中文本、复制内容，长备注自动换行。
winform.add(
    editSapTypeHelp = {
        cls = "edit";
        left = 444; top = 24; right = 620; bottom = 552;
        anchors = {left=1;top=1};
        multiline = 1;
        readonly = 1;
        autohscroll = false;
        vscroll = 1;
        edge = 1;
        bgcolor = 0xFFFFFF;
        font = LOGFONT(h=-13);
        text = "物料组说明";
    }
);

var formatSapTypeHelp = function(info){
    var text = "P11 物料组：" ++ info[1]
        ++ '\r\n\r\n描述：\r\n' ++ info[2]
        ++ '\r\n\r\n物料组备注：\r\n' ++ info[3];

    if(info[4]){
        text ++= '\r\n\r\n适用范围：\r\n' ++ info[4];
    }

    return text;
};

var updateSapTypeHelp = function(){
    //多选列表使用当前焦点项显示说明，不改变已有多选状态。
    //LB_GETCARETINDEX 返回原生的 0 基索引。
    var caretIndex = ::User32.SendMessageW(
        winform.clSapType.hwnd,
        0x019F/*_LB_GETCARETINDEX*/,
        0,0
    );

    if(caretIndex < 0){
        winform.editSapTypeHelp.text = "请选择物料组以查看说明。";
        return;
    }

    var code = winform.clSapType.items[caretIndex + 1];
    if(!code) return;

    var info = sapTypeHelp[code];
    if(!info){
        winform.editSapTypeHelp.text = code ++ '\r\n\r\n暂无辅助说明。';
        return;
    }

    var parts = ["S4 物料组：" ++ code];

    //多个用途时，info[1] 是数组；普通项目则是字符串。
    if(table.isArray(info[1])){
        for(i=1;#info){
            table.push(parts,formatSapTypeHelp(info[i]));
        }
    }
    else {
        table.push(parts,formatSapTypeHelp(info));
    }

    winform.editSapTypeHelp.text = string.join(
        parts,
        '\r\n\r\n────────────\r\n\r\n'
    );
};

//覆盖前面统一绑定的 oncommand，同时保留原来的颜色刷新。
winform.clSapType.oncommand = function(id,event){
    if(event == 1/*_LBN_SELCHANGE*/){
        updateSapTypeHelp();
    }

    refreshColor();
};

//初始显示当前焦点项说明。
updateSapTypeHelp();


win.loopMessage();
return winform;