}

winform.button4.oncommand = function(id,event){


	var fileList = {
		"qhc_product_info_lib.db", 
		"drawing_lists.db", 
		"qhcsap.db", 
		"qhc_OD_lib.db", 
		"tbm.db", 
		"qhc_dw_rel_list.db", 
		"Tarif.db", 
		"BOM_LIB.db"
	};
	for (i=1; #fileList)
		fileList[i] = io.joinpath(config.dbServer.path, fileList[i]);
	var copyfolder = function(winform, tart, dest){
		import global;
		if !io.exist(dest) return winform.log.print("无法访问:" + dest);
		import fsys;
		winform.log.print("...正在复制到" + dest);
		fsys.copy(tart, dest, 0x4/*_FOF_SILENT*/ + 0x10/*_FOF_NOCONFIRMATION*/);
		winform.log.print("完成:" + dest);
	}

	if winform.checkbox1.checked
		thread.invoke(copyfolder, winform, fileList, _qhc_db)
	if winform.checkbox2.checked
		thread.invoke(copyfolder, winform, fileList, _5g_db);
	if winform.checkbox3.checked
		thread.invoke(copyfolder, winform, fileList, _onedrive_db);
}
getXlsxDbPath = function(){
	import fsys;
	if !io.exist(config.admin.lastWorkingFolder) return null; 
	var list = fsys.list(/*config.admin.lastWorkingFolder*/"\\ccnqia05\temp-\SAP每周物料导出\",,"SAP所有物料*.xlsx");
	if #list 
		return list[list[#list]]; 
}

