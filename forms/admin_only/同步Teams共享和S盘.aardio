import console; 
//# 等待到晚上20:00后再开始后面的程序.
/*
console.showLoading("等待时间到达 20:00...");
while( time().hour < 20 ){
	sleep(1000);
}
*/
var sourceFolder = "C:\Users\ccl100100\CCR\CCR Detail Design - S - S\QHC图纸库";
var targetFolder = "S:\Cabinet\QHC图纸库"; 
import fsys;
import fsys.path;
import fsys.file;
import console.progress;

var bar = console.progress();
var fileList = {};

console.showLoading("正在扫描文件...");

// 遍历 sourceFolder 目录
fsys.enum( sourceFolder, "*.*",
    function(dirname,filename,fullpath,findData){ 
        if(filename){
            // 算出文件相对于当前源文件夹的相对路径
            var relPath = fsys.path.relative(fullpath, sourceFolder);

            // 直接从 findData 获取源文件的最后修改时间
            var tSrc = time();
            tSrc.fromFileTime(findData.ftLastWriteTime);

            // 将完整源路径、相对路径和修改时间存入表
            table.push(fileList, {
                src = fullpath;
                rel = relPath;
                time = tSrc;
            });
        }
    },
    // 第四个参数：目录筛选函数
    function(dirPath,dirName){
        /* 
        <@@obsolete@> 表示查找 "obsolete" 
        <@@ ... @> 语法会自动忽略大小写，并禁用内部特殊字符的正则含义
        */
        if( string.match(dirName, "<@@obsolete@>") ){
            return false; // 返回 false，直接跳过该目录的后续遍历
        }
        return true; // 返回 true 允许继续深入该目录
    }
);

var total = #fileList;

if(total == 0){
    console.log("没有扫描到需要同步的文件。");
    console.pause();
    return;
}

for(i=1; total; 1){
    var src = fileList[i].src;
    var rel = fileList[i].rel;
    var tSrc = fileList[i].time; 
    var dst = io.joinpath(targetFolder, rel);

    // 更新进度显示
    bar.setProgress(math.round(i / total * 100), "正在处理: " + rel);

    var needCopy = true;

    // 如果目标文件存在，则对比修改时间
    if(io.exist(dst)){
        var fDst = fsys.file(dst, "rb");
        if(fDst){
            var _, _, m2 = fDst.getTime();
            fDst.close();

            var tDst = time();
            if(m2) tDst.fromFileTime(m2);

            // 如果源文件时间小于等于目标文件时间，则跳过
            if(tonumber(tSrc) <= tonumber(tDst)){
                needCopy = false;
            }
        }
    }

    // 确认需要复制则进行文件拷贝
    if(needCopy){
        var dstDir = fsys.getParentDir(dst);
        if(!io.exist(dstDir)){
            fsys.createDir(dstDir);
        }
        fsys.copy(src, dst);
    }
}

// 清除进度条并打印完成信息
bar.reset();
console.log("同步完成！共扫描处理 " + total + " 个文件。");
console.pause();
