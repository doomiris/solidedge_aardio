import win.ui.menu;
import win.ui.grid;
import win.ui.toolbar;
import process;
import fsys;
import fsys.file;
import sqlite;
import com.excel;
import config;
import domisoft;
import tarray;
import win.inputBox;
import QHC;
import win.dlg.message;
import key;

winform.bindConfig( config.BOMExplorer,{
	checkbox = checked	
} );

var path = io.joinpath(config.dbServer.path,"BOM_LIB.db");
var search_path;
if !winform.chkFromServer.checked
	search_path = config.__sapDownload;
else
	search_path = io.joinpath(config.dbServer.path,"xl_lib","\");

var refreshDB = function(){
	return sqlite(path);
}

var grid = win.ui.grid(winform.listview);
var grid2 = win.ui.grid(winform.listview2);

grid.source = {};
grid2.source = {};
grid.reset = λ() owner.setTable(owner.source);
grid2.reset = grid.reset;
grid.onSortColumn = domisoft.listColSort;
var tbar;
var resetToolbar = function(){
    if tbar tbar.close();
    tbar = win.ui.toolbar(winform.custom);      
    tbar.create( style = 0x1000/*_TBSTYLE_LIST*/ + 0x200/*_TBSTYLE_WRAPABLE*/); 
    tbar.showLabel = true; 
    tbar.imageList = win.imageList(0,0).loadIcon(null); 
    tbar.add("❌ 重置",
        function(){
            for (i=1; #tbar.buttons)
                tbar.buttons[i].checked = false;
            grid.reset()
        }
    )
}

winform.frmReLoad = function(){
    var db = refreshDB();
    var t = db.getTable("SELECT DISTINCT 大类 FROM [lib]");
    var selIndex = grid2.lastSelIndex;
    grid2.source = t;
    grid2.setTable(grid2.source);
    db.close();
    grid2.onClick (selIndex);
}

// 修改后的筛选函数（支持 CTRL 多选 / 平常单选）
var filterTag = function(id){
    var isCtrlPressed = key.getState("CTRL"); 

    if (!isCtrlPressed) {
        for (i=1; #tbar.buttons) {
            var btn = tbar.buttons[i];
            if (btn.id != id) {
                btn.checked = false; 
            }
        }
    }

    var selectedTags = {};
    for (i=1; #tbar.buttons) {
        var btn = tbar.buttons[i];
        if (btn.checked && btn.text != "❌ 重置") {
            table.push(selectedTags, btn.text);
        }
    }

    if (#selectedTags == 0) {
        grid.reset();
        return;
    }

    // AND 筛选：数据行必须包含所有 selectedTags
    var st = table.filter(grid.source, function(row) {
        for(i=1; #selectedTags) {
            if(!table.find(row, selectedTags[i])) {
                return false; 
            }
        }
        return true; 
    });

    st.fields = grid.source.fields;
    grid.clear();
    grid.setTable(st);
}

var getTags = function(tab,fields){
    var t= {};
    for (i=1; #fields)
        table.append(t, tarray.getCol(tab, fields[i]));

    t = table.unique(t);
    table.removeByValue(t, "");

    resetToolbar();

    for (i=1; #t)
        // 去掉了 4/*_TBSTYLE_GROUP*/
        tbar.add(t[i], filterTag, /*img*/ , /* id */, 2/*_TBSTYLE_CHECK*/ + 0x10/*_TBSTYLE_AUTOSIZE*/)
}

winform.edit.onChange = function(){ 
	if(owner.onModified)owner.onModified(true);
	var txt = owner.text;
	var st = table.filter(grid.source, λ(v) string.find(v.物料描述, txt));
	st.fields = grid.source.fields;
	grid.clear();
	grid.setTable(st);
}
grid2.onClick = function(item,subItem,nmListView){
	if !item return ; 
	owner.lastSelIndex = item;
	var db = refreshDB();
// 同样确保查询时列存在，避免因老数据库结构引发报错
    try{ db.exec("ALTER TABLE [lib] ADD COLUMN `排序号` INTEGER DEFAULT 0;") }
    // 尾部追加了 ORDER BY 排序号
    var t = db.getTable(`SELECT 中类,小类,物料,物料描述,属性,可选项分类,喷粉分类,温度等级 FROM [lib] WHERE [大类]="` + owner.source[item]["大类"]+`" ORDER BY 排序号 ASC, rowid ASC;`)

	table.push(t.fields, "缓存日期");
	for (i=1;#t){
		var f = string.join({t[i]["物料"], t[i]["物料描述"]},"_") ++ ".xlsx";
		f = string.replace(f," ","_"); //在拼接前处理, 否则路径含空格
		f = io.joinpath(search_path, f);		
		if io.exist(f)
			t[i]["缓存日期"] = domisoft.getFileDate(f);
	}
	grid.source = t;
	winform.edit.text = "";

	grid.setTable(grid.source)
	
	grid2.ColumnWidth := domisoft.setColumnWidth(grid, {50,50,120,250,50,50,50,50})
	getTags(grid.source,{"中类","小类","属性","可选项分类","喷粉分类","温度等级"})
}


grid.onDoubleClick = function(item,subItem,nmListView){
	if !item return ; 
	var data = owner.getTable(owner.source.fields);
	var n = string.join({data[item]["物料"], data[item]["物料描述"]},"_") ++ ".xlsx";
	n = string.replace(n," ","_");
	var f = io.joinpath(search_path, n);	
	if !io.exist(f)
		winform.msgInfo("请先下载: "+'\n'++f,1000)
	else {
		var excel = com.GetOrCreateObject("Excel.Application");
		
        // 检测是否按住了 CTRL 键 (0x11 为 _VK_CONTROL 的虚拟键码)
        var isCtrlPressed = key.getState("CTRL"); 
        // 如果按住了 CTRL，则 readOnly 为 false（允许编辑）；否则为 true（只读）
        var readOnly = !isCtrlPressed;
        
		var wb = excel.WorkBooks.Open(f /* filename */,false /* UpdateLinks */, readOnly /* ReadOnly */);
		
		excel.ActiveWindow.DisplayRibbon = true; 

		win.showForeground(wb.Application.hwnd);
		win.setActive(wb.Application.hwnd);
	}

}
grid.copyfiles = function(tab){
	import win.clip.file;
	win.clip.file.write(tab,"copy");
}
grid.getCopyFilesList = function(){
	var tab = table.array();
	var data = owner.getTable(owner.source.fields);
	var selIndx = owner.selected;
	for (i=1; #selIndx ){
		var n = string.join({data[selIndx[i]]["物料"], data[selIndx[i]]["物料描述"]},"_") ++ ".xlsx";
		n = string.replace(n," ","_");
		var f = io.joinpath(search_path, n);	
		if io.exist(f)
			table.push(tab, f);
	}
	return tab;   
}


var downloadbom = function(){
	ctrl := grid;
    var tab=table.array();
    var data = ctrl.getTable(ctrl.source.fields);
    for (k, v in ctrl.selected){
        var bg = data[v]["物料"];
            table.push(tab,  bg);
    }  
    if !#tab return ;
    thread.invoke( 
    	function(wform,tab){
			import SAP;
			SAP.downloadBOM(wform, tab);
    	},ctrl.getParent(),tab
    )
};
grid.copyPartNo = function(fields){
    owner.doNotCopyColumns = [];

    // 获取总列数
    var colCount = owner.columnCount;
    if(!colCount && owner.columns) colCount = #owner.columns;

    // 遍历所有列，根据列标题匹配
    for(colIndex = 1; colCount; 1){
        // 获取列头标题
        var colTitle = owner.getColumnText ? owner.getColumnText(colIndex) : (owner.columns[[colIndex]][[1]]);

        // 如果该列不在待复制列表中，则排除
        if( !table.find(fields, colTitle) ){
            table.push(owner.doNotCopyColumns, colIndex);
        }
    }

    domisoft.copySelectedItem(owner);
    owner.doNotCopyColumns = [];
}

grid.deleteItems = function(){
	var selected = owner.selected;
	var flist = {};
	if !#selected return ; 
	var db = refreshDB();
	for (i=1; #selected)
		table.push(flist, owner.source[selected[i]]["物料"]);
	var dtype = winform.listview2.items[winform.listview2.selIndex]["大类"]
	if !win.msgboxTest("确认删除这些订单所有记录? " + '\n' + table.tostring(flist),"需要确认",winform.hwnd) return; 
	db = sqlite(path);
	db.exec("DELETE FROM `lib` WHERE ??", {{"大类" : dtype, "物料":flist}});
	db.close();	

	winform.frmReLoad();

}
grid2.deleteItems = function(){
	var selected = owner.selected;
	var flist = {};
	if !#selected return ; 
	var db = refreshDB();
	for (i=1; #selected)
		table.push(flist, owner.source[selected[i]]["大类"]);
	//var dtype = winform.listview2.items[winform.listview2.selIndex]["大类"]
	if !win.msgboxTest("确认删除这些订单所有记录? " + '\n' + table.tostring(flist),"需要确认",winform.hwnd) return; 
	db = sqlite(path);
	db.exec("DELETE FROM `lib` WHERE ??", {{"大类" : flist}});
	db.close();	

	winform.frmReLoad();

}
grid.updateProperty = function(prop, newValue){
	newValue := winform.inputBox("输入新内容", "变更["+prop+"]");
	if !newValue return ; 
	grid.updateData(prop,newValue)
	winform.frmReLoad();
}
grid.updateData = function(prop, newValue){
	var selected = owner.selected;
	var selectdCodes = {};
	for (i=1; #selected)
		table.push(selectdCodes, owner.source[selected[i]]["物料"])
	var sql = "UPDATE `lib` SET ? WHERE ??";
	sql = sqlite.format(sql, {{[prop]:newValue},{"物料":selectdCodes}});
	var db = refreshDB();
	db.exec(sql);	
	db.close();
}
grid.updateDespFromDB = function(){
	var selected = owner.selected;
	var selectdCodes = {};
	var db = refreshDB();
	
	for (i=1; #selected){
		var hcode = owner.source[selected[i]]["物料"];
		var newValue = QHC.getSapItem(hcode).物料描述;
		var sql = "UPDATE `lib` SET ? WHERE ??";	
		sql = sqlite.format(sql, {{"物料描述":newValue},{"物料":hcode}});
		db.exec(sql);	
	}
	db.close();
	winform.frmReLoad();
}
grid.saveSortOrder = function(){
    var db = refreshDB();
    // 尝试向数据表中新增 排序号 字段，如果已存在则自动静默忽略
    try{ db.exec("ALTER TABLE [lib] ADD COLUMN `排序号` INTEGER DEFAULT 0;") }

    // 获取当前选中展开的大类，用于精准定位
    var dtype = grid2.source[grid2.lastSelIndex]["大类"];

    // 开启事务执行批量更新，极大提升写入性能
    db.beginTrans();
    for(i=1; #owner.source){
        db.exec("UPDATE `lib` SET `排序号`=@sortOrder WHERE `大类`=@dtype AND `物料`=@hcode",{
            sortOrder = i;
            dtype = dtype;
            hcode = owner.source[i]["物料"];
        });
    }
    db.commitTrans();
    db.close();
}

grid.moveItem = function(direction){
    // 防护拦截：防止在筛选(搜索)状态下移动造成索引大范围窜乱
    if(winform.listview.count != #owner.source){
        winform.msgboxErr("当前处于筛选/搜索状态，无法调整排序！请清空重置后再操作。");
        return;
    }

    var selIndex = owner.selIndex;
    if(!selIndex) return; 

    var count = #owner.source;
    var targetIndex = selIndex;

    // 根据方向算出目标行
    if(direction == "up") targetIndex = selIndex - 1;
    elseif(direction == "down") targetIndex = selIndex + 1;
    elseif(direction == "top") targetIndex = 1;
    elseif(direction == "bottom") targetIndex = count;

    // 如果越界或无需移动则退出
    if(targetIndex < 1 || targetIndex > count || targetIndex == selIndex) return;

    // 在当前数据源数组中抽离项并插入到新位置
    var item = table.remove(owner.source, selIndex);
    table.insert(owner.source, item, targetIndex);

    // 刷新控件并恢复焦点选中状态，将视野滚动到那一行
    owner.setTable(owner.source);
    owner.setSelected(targetIndex);
    owner.ensureVisible(targetIndex);

    // 触发更新数据库
    owner.saveSortOrder();
}

var menu = win.ui.popmenu(winform);
var menu2 = win.ui.popmenu(winform);
menu.add("打开BOM", λ()	grid.onDoubleClick(winform.listview.selIndex));
menu.add("下载BOM...", downloadbom);
menu.add()
menu.add("上移一行", λ() grid.moveItem("up"));
menu.add("下移一行", λ() grid.moveItem("down"));
menu.add("上移到顶", λ() grid.moveItem("top"));
menu.add("下移到底", λ() grid.moveItem("bottom"));
menu.add("删除选定行", λ() grid.deleteItems());
menu.add()
menu.add("复制[物料]", λ() grid.copyPartNo(["物料"]));
menu.add("复制[物料][物料描述]", λ() grid.copyPartNo(["物料","物料描述"]));
menu.add("复制所选BOM文件...", λ() grid.copyfiles(grid.getCopyFilesList()));
menu.add()
menu.add("添加[中类]...", λ () grid.updateProperty("中类"));
menu.add("添加[小类]...", λ () grid.updateProperty("小类"));
menu.add("添加[可选项分类]...",λ () grid.updateProperty("可选项分类") );
menu.add("添加[喷粉分类]...",λ () grid.updateProperty("喷粉分类") );
menu.add("添加[温度等级]...",λ () grid.updateProperty("温度等级") );
menu.add()
menu.add("刷新[物料描述]...",λ () grid.updateDespFromDB() );

//menu2
menu2.add("删除选定行", λ() grid2.deleteItems());

grid.onRightClick = function(item,subItem,nmListView){
	if !item return ; 
	var x,y = win.getMessagePos();
	menu.popup(x,y,true,item);
}
grid2.onRightClick = function(item,subItem,nmListView){
	if !item return ; 
	var x,y = win.getMessagePos();
	menu2.popup(x,y,true,item);
}
winform.frmReLoad();

winform.splitter.split(winform.listview,winform.listview2);
winform.listview.doNotCopyColumns = {-1};

winform.chkFromServer.oncommand = function(id,event){
	if !winform.chkFromServer.checked
		search_path = config.__sapDownload;
	else
		search_path = io.joinpath(config.dbServer.path,"xl_lib","\");
	winform.frmReLoad();	
}

winform.listview.translateAccelerator = domisoft.ctrlC;
winform.listview2.translateAccelerator = domisoft.ctrlC;

winform.show();
win.loopMessage();
return winform;