var dcb = function(winform, absline, HT){
/*
import console
console.open()
*/

	import io;
	import config;
	import domisoft;
    import web.script;
    var vm = web.script("VBScript") ;
    var costFiles = [];

    var h = string.indexOf(HT, "-") ? string.split(HT, "-")[[1]] - 1 : tonumber(HT) - 1;
    var t = string.indexOf(HT, "-") ? string.split(HT, "-")[[2]] - 1 : tonumber(HT) - 1;
    
	winform.progress.pos = 0;
	winform.progress.min = h;
	winform.progress.max = t;
	vm.script = /*
			If Not IsObject(application) Then
   			Set SapGuiAuto  = GetObject("SAPGUI")
   			Set application = SapGuiAuto.GetScriptingEngine
			End If
			If Not IsObject(connection) Then
   			Set connection = application.Children(0)
			End If
			If Not IsObject(session) Then
   			Set session    = connection.Children(0)
			End If
			If IsObject(WScript) Then
   			WScript.ConnectObject session,     "on"
   			WScript.ConnectObject application, "on"
			End If
	*/
	/* 通过 vm.script 访问变量前需要先声明 */
	vm.script = /*
	    	dim i
	    	dim absline
	    	dim lib_path
	    	dim costFilename
			dim priceDate
			dim costFileExist
			dim guiTable
			costFileExist = False
			priceDate = session.findById("wnd[0]/usr/tabsTAXI_TABSTRIP_OVERVIEW/tabpT\01/ssubSUBSCREEN_BODY:SAPMV45A:4400/ssubHEADER_FRAME:SAPMV45A:4440/ctxtVBKD-PRSDT").text
			priceDate = Mid(priceDate,6,2) & right(priceDate,2)
	 */
	 vm.script.absline = absline;
	 vm.script.lib_path = config.__sapDownload;
	 for (i=h; t) {
	 	vm.script.i = i
	 	
	vm.script = /*
			Set guiTable = session.findById("wnd[0]/usr/tabsTAXI_TABSTRIP_OVERVIEW/tabpT\01/ssubSUBSCREEN_BODY:SAPMV45A:4400/subSUBSCREEN_TC:SAPMV45A:4900/tblSAPMV45ATCTRL_U_ERF_AUFTRAG")
			pcode = guiTable.GetCell(i,1).Text
			pdesp = guiTable.GetCell(i,2).Text
    		guiTable.GetAbsoluteRow(i  +  absline ).Selected = True    		
    		costFilename = "cost" & priceDate & "_" & trim(pcode) & "_" & trim(pdesp) & ".xlsx"
	*/

	vm.script.costFilename = domisoft.formatWindowsFileName(vm.script.costFilename);
	vm.script.costFileExist = !!io.exist(io.joinpath(vm.script.lib_path,vm.script.costFilename));

	winform.edit3.print(vm.script.costFilename)
	table.push(costFiles, io.joinpath(vm.script.lib_path,vm.script.costFilename));
	vm.script = /*
    		session.findById("wnd[0]/mbar/menu[3]/menu[4]").Select

    		set markcost = nothing 
    		popWinTitle=""
    		on error resume next
    			set markcost = session.findById("wnd[1]/usr/btnSPOP-VAROPTION2")
    			set useMark = session.findById("wnd[1]/usr/btnSPOP-VAROPTION1")
    			popWinTitle = session.findById("wnd[1]").Text
			on error goto 0


			if right(popWinTitle,6)="成本核算方法" then
					markcost.press
					session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpALLG/ssubALLGEMEIN:SAPLCKDI:4612/ctxtCKI64A-KLVAR").text = "PPC4"
					session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpALLG/ssubALLGEMEIN:SAPLCKDI:4612/ctxtCKI64A-UEBID").text = "PC03"	
			else
				if not markcost is nothing then
					useMark.press
    				'if not markcost is nothing then    				
    					'markcost.press
    					'on error resume next
        				'session.findById("wnd[1]/tbar[0]/btn[0]").press        			
        				'session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpALLG/ssubALLGEMEIN:SAPLCKDI:4612/ctxtCKI64A-KLVAR").text = "PPC4"
        				'session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpALLG/ssubALLGEMEIN:SAPLCKDI:4612/ctxtCKI64A-UEBID").text = "PC03"
        				'on error goto 0
  	
				else 
        			'set tdstr = nothing
        			'on error resume next
        				'set tdstr = session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpTERM/ssubTERM:SAPLCKDI:4614/ctxtCKI64A-KADAT")
        			'on error goto 0
        			'if not tdstr is nothing then
        				'msgbox(3)
        				'session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpTERM/ssubTERM:SAPLCKDI:4614/ctxtCKI64A-ALDAT").Text = tdstr.Text
        				'session.findById("wnd[0]/usr/subALL:SAPLCKDI:4611/tabsREITER/tabpTERM/ssubTERM:SAPLCKDI:4614/ctxtCKI64A-BWDAT").Text = tdstr.Text
        				
					'end if
					session.findById("wnd[0]/tbar[0]/btn[0]").press
					
    			end if
    		end if
			session.findById("wnd[0]/tbar[0]/btn[0]").press

			
			session.findById("wnd[0]/shellcont[0]/shell/shellcont[1]/shell[0]").pressContextButton "&PRINT_BACK"
			session.findById("wnd[0]/shellcont[0]/shell/shellcont[1]/shell[0]").selectContextMenuItem "&PRINT_PREV_ALL"

			session.findById("wnd[0]/mbar/menu[3]/menu[5]/menu[2]/menu[2]").select
			session.findById("wnd[1]/usr/subSUBSCREEN_STEPLOOP:SAPLSPO5:0150/sub:SAPLSPO5:0150/radSPOPLI-SELFLAG[2,0]").select

			session.findById("wnd[1]/tbar[0]/btn[0]").press
			session.findById("wnd[1]/tbar[0]/btn[20]").press
			
    		session.findById("wnd[1]/usr/ctxtDY_PATH").text = lib_path
    		session.findById("wnd[1]/usr/ctxtDY_FILENAME").Text = costFilename

			If costFileExist=True then
				session.findById("wnd[1]/tbar[0]/btn[11]").press
			Else
				session.findById("wnd[1]/tbar[0]/btn[0]").press
			End If

    		session.findById("wnd[0]/tbar[0]/btn[12]").press
    		session.findById("wnd[0]/tbar[0]/btn[12]").press
    		session.findById("wnd[0]/usr/tabsTAXI_TABSTRIP_OVERVIEW/tabpT\01/ssubSUBSCREEN_BODY:SAPMV45A:4400/subSUBSCREEN_TC:SAPMV45A:4900/tblSAPMV45ATCTRL_U_ERF_AUFTRAG").getAbsoluteRow( i  +  absline ).Selected = false
	*/
			winform.progress.pos = i
	}
	winform.button.disabledText = null;
	return costFiles; 

}

winform.button.oncommand = function(id,event){
	win.setTopmost(winform.hwnd); 
	var absline = winform.edit.text;
	if !#absline return ; 
	var HT = winform.edit2.text;
	if !#HT return ;
	owner.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷";text = "downloading..."};	
	var costFiles = thread.invokeAndWait(dcb, winform, absline, HT);
	win.setTopmost(winform.hwnd, false);
	if !costFiles return ; 
	if !#costFiles return ; 
	win.delay(500);
	//winform.button6.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷";text="working..."};
	import QHC;
	var t = thread.invokeAndWait(QHC.formatAllCostBom,winform,costFiles);
	
	if t and #t {
			winform.listview.setTable(t);
	}
	//winform.button6.disabledText = null;
	

}

winform.button3.oncommand = function(id,event){
	import process;
	process.explore(config.__sapDownload);	
}

winform.button2.oncommand = function(id,event){
/*
	import winex;
	if(!winex.find(,"^P11\(\d+\)/220")){
		return winform.msgInfo("还没启动SAPGUI",500);
	}
*/
    var mdlfrm = winform.loadForm("\dlg\inputbox2row.aardio");
    mdlfrm.text = "添加要卷算的成品编号";
    var itemData = mdlfrm.doModal();

    mdlfrm.edit2.setCueBannerText("请粘贴成品清单",true);  

	owner.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷";text="creating..."};
	var orderCreated = thread.invokeAndWait(createOrder, winform);
	if !orderCreated return ; 
  	if!itemData return ;  
  	
	var userinput = itemData[1];
    userinput = string.crlf(userinput,'\r\n' /* 默认值 */);
    //分隔符号转换行
	for k, v in {`、`, `，`, `;`, `；`, `,`, `|`,'\t'} 
		userinput = string.replace(userinput, v,'\r\n');	
    var userinputArr = string.split(userinput, '\r\n');
	userinputArr =  table.filter(userinputArr, function(v,index){
		return string.len(string.trim(v)); 
	})
	thread.invoke(function(txt){
    	import web.script;
    	var vm = web.script("VBScript");
    	vm.script = /*
			If Not IsObject(application) Then
   				Set SapGuiAuto  = GetObject("SAPGUI")
   				Set application = SapGuiAuto.GetScriptingEngine
			End If
			If Not IsObject(connection) Then
   				Set connection = application.Children(0)
			End If
			If Not IsObject(session) Then
   				Set session    = connection.Children(0)
			End If
			If IsObject(WScript) Then
   				WScript.ConnectObject session,     "on"
   				WScript.ConnectObject application, "on"
			End If		
    	*/    	
    	vm.script = /*
    		Set tabCtrl = session.findById("wnd[0]/usr/tabsTAXI_TABSTRIP_OVERVIEW/tabpT\01/ssubSUBSCREEN_BODY:SAPMV45A:4400/subSUBSCREEN_TC:SAPMV45A:4900/tblSAPMV45ATCTRL_U_ERF_AUFTRAG")
			Dim i
			i = 1
			dim txt
		*/
		for (i=1; #txt) {
			vm.script.i = i;
			vm.script.txt = txt[i];
			vm.script = /*			
				tabCtrl.Columns.item(1).item(i-1).Text = txt
				tabCtrl.Columns.item(3).item(i-1).Text = "1"
			*/
		}
	}, userinputArr)
}



winform.button5.oncommand = function(id,event){
	owner.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷";text="working..."};
	var sss = thread.invokeAndWait(filterRed, winform);
	owner.disabledText = null;	
	if !sss or !#sss return ; 
/*
	import win.clip
	var sss = win.clip.read();
	sss ?= string.trimright(sss, '\n');
*/
	var tab = table.concat(winform.listview2.items, sss);
	winform.listview2.setTable(tab);

/*
	winform.edit3.dump(sss)
	winform.edit3.print('\n');
*/
	
}
winform.listview2.setColumns([
		["相关物料", 100],
		["错误描述", 400]
])
winform.listview2.translateAccelerator = domisoft.ctrlC;

winform.button6.oncommand = function(id,event){
	owner.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷";text="working..."};
	thread.invoke( 
		function(wform){
			import QHC;
			var t = QHC.formatAllCostBom();
			wform.listview.setTable(t);
			wform.button6.disabledText = null;
		}, winform
	)

}

winform.button7.oncommand = function(id,event){
	owner.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷"}
	thread.invoke( 
		function(wform){
			import QHC;
			var t = QHC.getPriceList();
			if t and #t { 
				wform.listview.setTable(t);
			}
			wform.button7.disabledText = null;
		}, winform
	)
}

