import win.ui;
/*DSG{{*/
var winform = win.form(text="管理Excel窗口信息";right=759;bottom=469)
winform.add(
listview1={cls="listview";left=13;top=22;right=212;bottom=453;db=1;dl=1;dt=1;edge=1;fullRow=1;z=1};
listview2={cls="listview";left=224;top=22;right=734;bottom=449;db=1;dr=1;dt=1;edge=1;fullRow=1;z=2};
splitter={cls="splitter";left=214;top=25;right=220;bottom=451;frame=1;z=3}
)
/*}}*/

import win.ui.grid;
import win.ui.menu;
import process;
import com;
import winex;
import winex.mainWindows;
winform.splitter.split(winform.listview1, winform.listview2);

// 初始化数据网格
var grid1 = win.ui.grid(winform.listview1);
var grid2 = win.ui.grid(winform.listview2);


/*
# grid1 列出当前用户打开的所有excel进程
# grid1 切换选中项时, 把选中进程标记为当前Excel应用,  在grid2里列出当前Excel应用内所有打开的文档
# grid2 可以批量选择打开的文档, 右键菜单: 关闭选中的文件(放弃修改), 关闭选中的文件(保存修改)
# grid1 右键菜单: 结束此进程(放弃所有修改), 结束此进程(保存所有修改), 刷新Excel进程
# 使用grid自带的onRightClick方法创建右键菜单
*/

grid1.columns = [
	["PID", 60],
	["进程标题", -1]
];

grid2.columns = [
	["文档名称", 180],
	["文件路径", -1]
];

var currentExcelApp = null;

var refreshExcelProcess = function(){
	grid1.clear();
	grid2.clear();
	currentExcelApp = null;
	
	for i,hwnd,title,visible,pid,tid in winex.mainWindows.each("EXCEL.EXE"){
		if(title && #title){
			grid1.addItem([tostring(pid), title]);
		}
	}
}

grid1.onSelChanged = function(selected,row,col){
	if(!selected) return;
	
	grid2.clear();
	currentExcelApp = null;



    // 方案 1：使用 com.enumRunning 遍历运行对象表（ROT）
    // Excel 通常会在 ROT 里注册已打开的工作簿完整路径，可以通过工作簿反向获取 Application
    var validExts = { [".xls"]=true; [".xlsx"]=true; [".csv"]=true; [".xlsm"]=true };
	com.enumRunning( 
		function(displayName,obj){
        	var ext = string.lower(io.splitpath(displayName).ext : "");
			if( validExts[ext] ){
            	if(obj.Application && obj.Application.Name == "Microsoft Excel"){
                	currentExcelApp := obj.Application;  
            	}
        	}
    	}
	)
    // 方案 2：作为兜底，使用 com.GetObject 获取当前活动实例（这是 aardio 里替代 GetActiveObject 的标准做法）
    if(!currentExcelApp){
        currentExcelApp = com.GetObject("Excel.Application");
    }

     // 渲染文件列表
    if(currentExcelApp){
        for(i=1; currentExcelApp.Workbooks.Count; 1){
            var wb = currentExcelApp.Workbooks(i);
            grid2.addItem([wb.Name, wb.FullName]);
        }
    }
}

grid1.onRightClick = function(row,col){
	if(!row) return;
	
	var popmenu = win.ui.popmenu(winform);
	
	popmenu.add('结束此进程(放弃所有修改)', function(id){
		var pid = tonumber(grid1.getItemText(row, 1));
		if(pid) process.kill(pid);
		refreshExcelProcess();
	});
	
	popmenu.add('结束此进程(保存所有修改)', function(id){
		var pid = tonumber(grid1.getItemText(row, 1));
		if(currentExcelApp){
			try{
				for(i=1; currentExcelApp.Workbooks.Count; 1){
					currentExcelApp.Workbooks(i).Close(true);
				}
				currentExcelApp.Quit();
			}
		}
		if(pid) process.kill(pid);
		refreshExcelProcess();
	});
	
	popmenu.add('刷新Excel进程', function(id){
		refreshExcelProcess();
	});
	
	popmenu.popup();
}

grid2.onRightClick = function(row,col){
	if(!row) return;
	
	var popmenu = win.ui.popmenu(winform);
	
	popmenu.add('关闭选中的文件(放弃修改)', function(id){
		if(!currentExcelApp) return;
		
		var files = {};
		for item, val in grid2.eachSelected(1){
			table.push(files, val);
		}
		
		try{
			for(i=1; #files; 1){
				currentExcelApp.Workbooks(files[i]).Close(false);
			}
		}
		
		if(grid1.selIndex) grid1.onSelChanged(true, grid1.selIndex, 1);
	});
	
	popmenu.add('关闭选中的文件(保存修改)', function(id){
		if(!currentExcelApp) return;
		
		var files = {};
		for item, val in grid2.eachSelected(1){
			table.push(files, val);
		}
		
		try{
			for(i=1; #files; 1){
				currentExcelApp.Workbooks(files[i]).Close(true);
			}
		}
		
		if(grid1.selIndex) grid1.onSelChanged(true, grid1.selIndex, 1);
	});
	
	popmenu.popup();
}

refreshExcelProcess();
// 如果 grid1 有数据，默认选中第一行
if(winform.listview1.count > 0){
    winform.listview1.selIndex = 1;
}


winform.show();
win.loopMessage();
