/*DSG{{*/
winform = win.form(text="SE许可证工具";right=751;bottom=599;bgcolor=0xFFFFFF)
winform.add(
btnQuery={cls="plus";text="立即查询所有服务器";left=16;top=13;right=216;bottom=53;align="left";bgcolor=0xB0B68F;dl=1;dt=1;font=LOGFONT(h=-14);iconStyle={align="left";font=LOGFONT(h=-15;name='FontAwesome');padding={left=15}};iconText='\uF021';notify=1;textPadding={left=45};z=2};
listviewResult={cls="listview";left=20;top=72;right=730;bottom=580;db=1;dl=1;dr=1;dt=1;edge=1;fullRow=1;gridLines=1;z=1};
radioServer1={cls="plus";text="上海 Office";left=410;top=13;right=570;bottom=53;align="left";dr=1;dt=1;font=LOGFONT(h=-13);iconStyle={align="left";font=LOGFONT(h=-16;name='FontAwesome')};iconText='\uF111 ';notify=1;textPadding={left=22};z=3};
radioServer2={cls="plus";text="青岛 Office";left=575;top=13;right=735;bottom=53;align="left";dr=1;dt=1;font=LOGFONT(h=-13);iconStyle={align="left";font=LOGFONT(h=-16;name='FontAwesome')};iconText='\uF111 ';notify=1;textPadding={left=22};z=4}
)
/*}}*/

winform.grid = win.ui.grid(winform.listviewResult);
winform.grid.setReadonlyColumns(-1);
winform.listviewResult.translateAccelerator = domisoft.ctrlC;

// 配置 listview 标题列 (去除了 剩余/总计 文本)
winform.grid.columns = [
    ["服务器", 100],
    ["编号", 50],
    ["姓名", 200],
    ["账户", 100],
    ["计算机", 140],
    ["借出剩余时间", -1]
];
winform.listviewResult.fillParent(3);

// 配置信息
var serverConfig = {
    lmutilPath = io.joinpath(_STUDIO_INVOKED ? "S:\Admin\Addons\" : io._exedir, "ext", "se_tool", "lmutil.exe");
    featureName = "solidedgepremium";
    list = {
        { title = "上海 Office"; addr = "28000@CCNSIA1A" };
        { title = "青岛 Office"; addr = "28000@CCNQIA05" }
    }
}

// 建立线程安全的共享表（用于存放有空闲 License 的服务器地址）
var sharedAvailable = thread.table("AVAILABLE_LICENSE_SERVERS", true);

// 按钮交互样式
var btnSkin = {
    background={ default=0xFFEEEEEE; hover=0xFFDDDDDD; active=0xFFCCCCCC; };
    color={ default=0xFF333333; hover=0xFF000000; }
}
winform.btnQuery.skin(btnSkin);

// 【新增】配置单选框交互样式并应用
var radioSkin = {
    group = "ServerGroup"; // 分组名相同的单选框会自动实现单选互斥
    color = {
        default = 0xFF333333;
        hover = 0xFF005A9E;
        active = 0xFF0078D4;
    };
    iconColor = {
        default = 0xFF999999;
        hover = 0xFF005A9E;
    };
    checked = {
        iconText = '\uF058'; // 选中时显示实心圆勾
        iconColor = { default = 0xFF0078D4; };
    }
}
winform.radioServer1.skin(radioSkin);
winform.radioServer2.skin(radioSkin);

// 【新增】动态设置包含额外服务器地址的多行文本
winform.radioServer1.text = serverConfig.list[1].title ++  '\n' ++ serverConfig.list[1].addr;
winform.radioServer2.text = serverConfig.list[2].title ++ '\n' ++ serverConfig.list[2].addr;

// -------------------------------------------------------------
// 初始化：查询当前环境变量，并默认选中系统当前服务器
// -------------------------------------------------------------
var initCurrentServer = function(){
    var currentServer = "";

    // 优先查询用户环境变量
    var regUser = win.reg("HKEY_CURRENT_USER\Environment", true); 
    if(regUser){
        currentServer = regUser.queryValue("SE_LICENSE_SERVER") : "";
        regUser.close();
    }

    // 若用户变量不存在，再查询系统环境变量
    if(!#currentServer){
        var regSys = win.reg("HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Session Manager\Environment", true);
        if(regSys){
            currentServer = regSys.queryValue("SE_LICENSE_SERVER") : "";
            regSys.close();
        }
    }

    // 依据查询结果勾选界面单选按钮 (利用 plus 控件的 checked 属性)
    if(currentServer == serverConfig.list[1].addr){
        winform.radioServer1.checked = true;
    }
    elseif(currentServer == serverConfig.list[2].addr){
        winform.radioServer2.checked = true;
    }
}

// 执行初始化检索
initCurrentServer();

// 统一的服务器切换函数
var switchServer = function(addr, title){
    import environment;

    // 写入用户环境变量
    environment.user().update({"SE_LICENSE_SERVER": addr});

    winform.msgInfo("成功！已将 SE_LICENSE_SERVER 切换至：" + '\r\n' 
        + title + " (" + addr + ")" + '\r\n\r\n' 
        + "提示：请重启 Solid Edge 以加载新配置。", 3000);
}

// 单选按钮1 点击事件
winform.radioServer1.oncommand = function(id,event){
    if(owner.checked){
        switchServer(serverConfig.list[1].addr, serverConfig.list[1].title);
    }
}

// 单选按钮2 点击事件
winform.radioServer2.oncommand = function(id,event){
    if(owner.checked){
        switchServer(serverConfig.list[2].addr, serverConfig.list[2].title);
    }
}

// 查询所有服务器状态
winform.btnQuery.oncommand = function(id,event){
    winform.btnQuery.disabledText = {'\uf110';'\uf111';'\uf112';'\uf113';'\uf114'};
    winform.text = "SE许可证工具 - 正在同步查询所有服务器状态, 请稍候...";

    // 清空上次结果
    winform.grid.clear();
    sharedAvailable.clear(); 

    thread.invoke( 
        function(winform, serverConfig){
            import process.popen;
            import thread.table;
            import com.wmi; 
            import fsys.table;

            var shared = thread.table("AVAILABLE_LICENSE_SERVERS");
            var allRows = {}; // 二维数组，存放准备填入 listview 的数据

            var cachePath = io.joinpath(io.splitpath(serverConfig.lmutilPath).dir, "userCache.table");
            var displayNameCache = fsys.table(cachePath); 
            var cacheUpdated = false;

            for(i=1;#serverConfig.list;1){
                var server = serverConfig.list[i];
                var cmd = `"` + serverConfig.lmutilPath + `" lmstat -f ` + serverConfig.featureName + " -c " + server.addr;
                var prcs = process.popen(cmd);

                if(prcs){
                    var result = prcs.readAll();
                    prcs.close();

                    var totalLic = tonumber(string.match(result, "Total of\s+(\d+)\s+licenses issued") : "0");
                    var inUseLic = tonumber(string.match(result, "Total of\s+(\d+)\s+licenses in use") : "0");
                    var freeCount = totalLic - inUseLic;

                    if(freeCount > 0) shared[server.addr] = server.title;

                    var usedList = {}; // 用于按顺序收集已被占用的许可证记录
                    for line in string.lines(result) {
                        if(!string.find(line, "\s+start\s+")) continue;

                        var user, pc = string.match(line, "^\s*(\S+)\s+(\S+)");

                        if(user && pc){
                            if(!displayNameCache[user]){
                                var userAccount = com.wmi.get("SELECT FullName FROM Win32_UserAccount WHERE Name=@name",{ name = user });
                                displayNameCache[user] = (userAccount && userAccount.FullName) ? userAccount.FullName : user;
                                cacheUpdated = true;
                            }

                            var displayName = displayNameCache[user]; 
                            var remainSeconds = string.match(line, "linger\:\s*(\d+)");
                            var timeDesc = "";

                            if(remainSeconds){
                                var s = tonumber(remainSeconds);
                                var days = math.floor(s / 86400);
                                var hours = math.floor((s % 86400) / 3600);

                                if(days > 0) timeDesc = days + "天" + (hours > 0 ? hours + "时" : "");
                                else timeDesc = hours + "小时";
                            }

                            table.push(usedList, { displayName; user; pc; timeDesc });
                        }
                    }

                    // 按照该服务器支持的总许可证数(totalLic)循环生成固定行数
                    for(j=1; totalLic; 1){
                        var usedInfo = usedList[j];
                        if(usedInfo){
                            // 如果有对应占用记录则填入真实信息
                            table.push(allRows, { server.title; tostring(j); usedInfo[1]; usedInfo[2]; usedInfo[3]; usedInfo[4] });
                        }
                        else{
                            // 否则此行显示为空闲状态
                            table.push(allRows, { server.title; tostring(j); "空闲"; ""; ""; "" });
                        }
                    }
                }
            }

            if(cacheUpdated){
                displayNameCache.save();
            }

            // 更新到界面的 Listview 列表中
            winform.grid.setTable(allRows);

            // 恢复界面状态
            winform.text = "SE许可证工具 - 查询完成：" + tostring(time());
            winform.btnQuery.disabledText = null;

        }, winform, serverConfig
    )
}
