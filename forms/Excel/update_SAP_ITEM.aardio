/* 行转列显示 */
tab = tarray.transpose(tab);

var fields = { [1] = "可用字段"; [2] = "绑定到列"}
tab = tarray.mapfields(tab, fields);

import win.ui.grid
var grid = win.ui.grid(winform.listview);
grid.setTable(tab);
grid.setReadonlyColumns(1)
winform.listview.checkbox = true;
//winform.listview.setChecked(0);

import com.excel;
var excel;
var sht;

winform.frmReLoad = function(){
	import etip;
	grid.clear();

	winform.titleRow = null;
	
	excel := com.excel(false);
	if !excel return ; 
	if !excel.ActiveWorkbook return ; 
	sht = excel.ActiveWorkbook.ActiveSheet;
	winform.static.text = sht.parent.Name ++ "![" ++ sht.name ++ "]";
	
	var titleRng = sht.range("A1:Z10");
	var f = titleRng.find("物料描述") || titleRng.find("对象描述") ||titleRng.find("名称")|| titleRng.find("对象标识") ;
	if !f return ; 
	winform.titleRow = f.row;
	titleRng = titleRng.value2[[winform.titleRow]];	//查找范围前10行
	/* 在此处添加不同表格存在的不同列名命名方式 */
	titleRng = tarray.replaceValue(titleRng,"专用号", "物料"); 
	titleRng = tarray.replaceValue(titleRng,"对象标识", "物料"); 
	titleRng = tarray.replaceValue(titleRng,"对象描述", "物料描述"); 
	titleRng = tarray.replaceValue(titleRng,"SAP展开尺寸", "生产展平尺寸"); 
	titleRng = tarray.replaceValue(titleRng,"SAP展平尺寸", "生产展平尺寸"); 
	titleRng = tarray.replaceValue(titleRng,"单价", "价格"); 
	for (i=1; #tab){
		var match = tarray.indexContains(titleRng, tab[i][fields[1]]);
		if !match continue;
		tab[i][fields[2]] = etip.toColName(match) ;
		winform.titleRow := winform.titleRow;
		winform.edit.text = winform.titleRow + 1;
		winform.edit2.text = sht.usedrange.rows[sht.usedrange.rows.count].row;
	}
	grid.setTable(tab);
/*
	for(i=1;#tab)
		winform.listview.setChecked(i, tab[i][fields[2]]!=="")
*/
}

winform.button2.oncommand = winform.frmReLoad;


var update = function(winform, tab){
    import win;
    import com.excel;
    import tarray;
    import QHC;

    /* 缓存以减少查询次数 */
    var sapCache = {};
    var sapCacheCol = {};

    var start_row = tonumber(winform.edit.text);
    var end_row = tonumber(winform.edit2.text);
    if(!start_row || !end_row || start_row > end_row){
        return winform.msgboxErr("起始行或结束行设置错误", 1000);
    }

    var excel = com.excel(false);
    if !excel return winform.msgboxErr("未找到打开的 Excel 进程", 1000); 
    var sht = excel.ActiveWorkbook.ActiveSheet;
    sht.AutoFilterMode = false;
    for (i=1; sht.ListObjects.Count)
        sht.ListObjects.item(i).AutoFilter.ShowAllData();

    excel.alerts = false;

    var tCount = sht.usedrange.rows[sht.usedrange.rows.count].row;  
    var items = winform.listview.items;

    for (i=1; #tab) 
        tab[i].绑定到列 = items[i][2] : "";

    var key = tarray.mapAsItem(tab, tab.fields[1], tab.fields[2]); // 字段和列号对应起来
    if(!key.物料){
        excel.alerts = true;
        return winform.msgboxErr("未找到绑定到【物料】的列", 1000);
    }

    var ucol = winform.listview.checked; // 用户选中的列
    if(!#ucol){
        excel.alerts = true;
        return winform.msgboxErr("请先勾选需要更新的列", 1000);
    }

    // 从第 1 行获取到 tCount 行，确保 keyCol[i] 的下标与物理行号 i 完全对应
    var keyCol = sht.range(key.物料 ++ "1:" ++ key.物料 ++ tCount).value2;

    var rowCount = end_row - start_row + 1;
    var columnUpdates = {}; // 存储按列分组的数据
    //var fieldMapping = winform.fieldMapping : {};

    // 1. 预先初始化所有选中列的数组结构，默认值全部填充为 [ "" ]，确保无论是否查到物料，数据结构都是完全规整的二维数组
    for (j=1; #ucol){
        var col = items[ucol[j]][2];
        if(col && #col && !columnUpdates[col]){
            var colArr = table.array(rowCount);
            for(r=1; rowCount){
                colArr[r] = [""]; // 每一项必须为单元素数组 [""]，对应 Excel 的单个单元格
            }
            columnUpdates[col] = colArr;
        }
    }

    // 2. 遍历并填入查询结果
    for (i = start_row; end_row){
        var rowIdx = i - start_row + 1;

        // 严谨判断空行与格式
        if (!keyCol || !keyCol[i] || !keyCol[i][1]) continue;
        var matCode = tostring(keyCol[i][1]);
        //if (!string.startsWith(matCode, "5")) continue;

        var hitem;
        var cacheIdx = table.indexOf(sapCacheCol, matCode);
        if (cacheIdx){
            hitem = sapCache[cacheIdx];
        }
        else {
            // 安全查询物料数据
            hitem = QHC.getSapItem(matCode);
            if (!hitem) {
                hitem = { 物料 = matCode }; // 查询为空或失败时兜底
            }
            table.push(sapCache, hitem);
            table.push(sapCacheCol, matCode);
        }

        for (j=1; #ucol){
            var hitemname = items[ucol[j]][1];
            //var mappedName = fieldMapping[hitemname] || hitemname;
            var col = items[ucol[j]][2];

            if (columnUpdates[col]) {
                // 获取字段值，如果为 null 则安全回退为空字符串 ""
                var val = (hitem && hitem[hitemname] !== null) ? tostring(hitem[hitemname]) : "";
                columnUpdates[col][rowIdx] = [ val ];
            }
        }
    }

    // 3. 按列批量写入数据到 Excel
    var hasError = false;
    for (col, colData in columnUpdates) {
        var rangeStr = col ++ start_row ++ ":" ++ col ++ end_row;
        try{
            sht.range(rangeStr).value2 = colData;
        }
        catch (e){            
            hasError = true;
            excel.alerts = true;
            winform.msgboxErr("写入列 " ++ col ++ " 失败: " ++ tostring(e));
        }
    }

    excel.alerts = true;
    if(!hasError){
        winform.msgInfo("更新完成", 1000); 
    }
    return true;
}


winform.button.oncommand = function(id,event){
	owner.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷";text="等待进程执行..."}
	var rez = thread.invokeAndWait(update, winform, tab);	
	if rez
		winform.button.disabledText = null;
}
winform.onDestroy = function(){
   	if excel 	excel.alerts = true;    //防止意外关闭后Excel假死
    if excel 	excel = null;
    if sht    	sht = null;
}
// 1. 创建内存缓存字典
import thread.table;

// ✅ 线程共享表：可跨线程传递，读写自动加锁，多次点击还能复用缓存
var matCache = thread.table("matCache");


winform.button3.oncommand = function(id,event){
	if !winform.msgAsk("原地更新所选中的物料号(旧号换新号)") return ; 
	winform.button3.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷"; text = " "};
	thread.invoke( 
		function(winform,matCache){
			import com;
			import domisoft;
			import config
			import QHC;
			import sqlite;
			var db = QHC.openDb(QHC.sap_db_path);

			/*
			# 获取当前Active Sheet里选中内容,
			# 只要是BG开头或H008开头的字串就认为是pnumber
			# 用类似以下语句查询名为:S4物料 的值
			# db.stepQuery("SELECT S4物料 FROM [所有物料]", {物料:pnumber} )
			# 原地替换为新的S4物料
			*/
			import com.excel;
			var excel = com.excel(false);
			if !excel    return;
			if !db    return;
			var selection = excel.Selection;
			if !selection    return;		
			
			var replaceCount = 0;
			var cacheHitCount = 0; // 统计缓存命中次数
			
			// 2. 临时关闭 Excel 屏幕更新与弹窗，大幅提升遍历写入速度
			excel.Application.ScreenUpdating = false;
			excel.alerts = false;
			
			var count = selection.Count;
			for(i=1;count;1){
    			var cell = selection.Item(i);
    			var pnumber = cell.Value2 ? tostring(cell.Value2) : "";
    			
    			if(string.startsWith(pnumber, "BG") || string.startsWith(pnumber, "H008")){
        			var s4Number = matCache[pnumber];
			
        			// 缓存未命中（尚未查询过该物料）
        			if(s4Number === null){
            			var result = db.stepQuery("SELECT 物料 FROM [所有物料]", {旧物料号 = pnumber});
            			if(result && result["物料"]){
                			s4Number = result["物料"];
            			}
            			else {
                			s4Number = false; // 标记未查到，防止后续对相同无效料号重复查库
            			}
            			matCache[pnumber] = s4Number; // 写入缓存
        			}
        			else {
            			cacheHitCount++; // 命中缓存
        			} 
        			// 如果存在对应的 S4 物料号则替换
        			if(s4Number){
            			cell.Value2 = s4Number;
            			replaceCount++;
           			// console.log("替换成功:", pnumber, "->", s4Number);
        			}
			
    			}
			}
			
			// 3. 恢复 Excel 屏幕更新
			excel.Application.ScreenUpdating = true;
			excel.alerts = true;
			winform.button3.disabledText = null;
		}, winform,matCache
	)
}


winform.onDestroy = function(){
    if excel
    	excel = null;
    if sht
    	sht = null;
}
if !winform.parent
	win.setForeground(winform.hwnd);
if !winform.parent
	winform.frmReLoad();
winform.show();
win.loopMessage();
return winform;