import win.ui;
/*DSG{{*/
var winform = win.form(text="填写专用号申请表";right=759;bottom=400;image=$"\res\SE BG.jpg";bkBottom=0;bkLeft=0;bkRight=0;bkTop=0)
winform.add(
button={cls="button";text="开始";left=9;top=6;right=137;bottom=47;anchors={left=1;top=1};z=1};
combobox2={cls="combobox";left=146;top=16;right=749;bottom=42;anchors={left=1;top=1;right=1};edge=1;items={};mode="dropdownlist";z=3};
listview={cls="listview";left=0;top=60;right=760;bottom=369;ah=1;anchors={left=1;top=1;right=1;bottom=1};edge=1;fullRow=1;gridLines=1;z=2};
progress={cls="progress";left=0;top=370;right=760;bottom=400;anchors={left=1;right=1;bottom=1};max=100;min=0;z=4}
)
/*}}*/

import tarray;
import com.excel;
import string.keywords;
import config;
import fsys.table;
import QHC;
import domisoft;
import win.dlg.message;
var excel_0 = com.excel(false);
var excel_2;
var getErr = {};
var etab = {};
import etip;
var rowNames = "序号;销售组织;长度检查;外部物料号;申请人;申请日期;物料描述;已喷未喷对应关系;基本计量单位;产品大类;物料类型;采购类型;P11物料组;SAP颜色分组;属性;物料分类明细;材质分类;用途;SAP展开尺寸;是否关键部件;毛重;净重;S4物料组;"
var fieldName = string.splitLiteral(rowNames,";");
var findCol = function(colName){
	return table.find(fieldName,colName); 
}



import com;

winform.frmReLoad = function(){
    var activeName;
    var itemList = {};
    var targetIndex = 1;

    com.enumRunning( 
        function(displayName,object){
            try{
                var s = com.GetTypeInfo(object).GetDocumentation().name;
                if(s == "_Workbook"){
                    // 直接从当前运行的 Workbook 获取激活工作簿名称，准确且不会连错进程
                    if(!activeName && object.Application && object.Application.ActiveWorkbook){
                        activeName = object.Application.ActiveWorkbook.Name;
                    }
                    if(string.keywords('新增|专用号|申请').findOne(displayName)){
                        table.push(itemList, displayName);
                        // 兼容 displayName 是完整路径或纯文件名的情况
                        if(activeName && (displayName == activeName || io.splitpath(displayName).file == activeName)){
                            targetIndex = #itemList;
                        }
                    }
                }
            }
        }
    )

    // 直接整体赋值 items，避免 clear + 逐个 add 引起的多次重绘
    winform.combobox2.items = itemList;
    if(#itemList){
        winform.combobox2.selIndex = targetIndex;
    }
}
winform.frmReLoad();

winform.combobox2.onDropDown = function(){
    winform.frmReLoad();
    // 关键：在 onDropDown 中动态刷新列表后，延迟到下拉列表展开完成后再同步一次选中项
    winform.setTimeout(function(){
        if(winform.combobox2.count && !winform.combobox2.selIndex){
            winform.combobox2.selIndex = 1;
        }
    }, 10);
}



winform.button.oncommand = function(id,event){
    var selWorkbookName = winform.combobox2.selText;
    if !#selWorkbookName return; 

    // 1. 首次使用输入姓名（放在禁用按钮前，避免模态框与置顶冲突）
    import config;
    import win.inputBox;
    config.tbm.Designer := winform.inputBox("这是第一次使用, 请先输入姓名:", "姓名");
    config.tbm.save();
    var username = config.tbm.Designer;

    // 2. 开启按钮等待动画，置顶窗口
    winform.button.disabledText = {"✶";"✸";"✹";"✺";"✹";"✷"; text = "处理中"};
    win.setTopmost(winform.hwnd);

    // 定义统一的收尾恢复函数（无论成功还是中途报错都能恢复按钮状态）
    var cleanUp = function(statusText){
        if excel_0 excel_0.alerts = true;
        if excel_2 excel_2.alerts = true;
        sht = null;
        try{
            com.Release(sht);
            com.Release(excel_2);
            com.Release(excel_0);
        }
        collectgarbage("collect");
        win.setTopmost(winform.hwnd, false);
        winform.button.disabledText = null; // 停止动画并恢复按钮
        if(statusText) winform.progress.text = statusText;
    }

    sht = domisoft.getRunningWorkSheet(selWorkbookName);
    if(!sht){
        cleanUp("获取工作表失败");
        return;
    }
    excel_2 = sht.Parent.Application;

    if sht.AutoFilterMode
        sht.AutoFilterMode = false;
    if sht.ListObjects.Count {
        for (i=1;sht.ListObjects.Count){            
            select(sht.ListObjects.item(i).Name) {
                case "Table1","表1" {
                    sht.ListObjects.item(i).AutoFilter.ShowAllData();
                    break;
                }
            }
        }
    }

    if !sht.Rows("2:2").find("物料描述") {
        cleanUp("格式错误：缺少[物料描述]");
        return error("专用号申请表格式错误"); 
    }
    if !sht.Rows("2:2").find("销售组织") {
        cleanUp("版本错误：缺少[销售组织]");
        return error("不是最新版专用号申请表"); 
    }

    var etr = function(){
        return sht.usedrange.rows[sht.usedrange.rows.count].row;
    }

    var lastRow = etr();
    var maxCol = findCol("S4物料组");
    var tRng = sht.Range("A3:" ++ etip.toColName(maxCol) ++ lastRow);

    var etab = tRng.value;
    var etab_count = #etab;

    // 3. 初始化进度条范围 (预留20%给Excel写入阶段)
    var bar = winform.progress;

    var writeSteps = math.max(5, math.floor(etab_count * 0.25));
    var totalSteps = etab_count + writeSteps;
    bar.setRange(0, totalSteps);
    bar.pos = 0;
    bar.text = "正在读取并分析数据...";

	import time.ole;

    var str_today = function(separator){
        var tm = time.now();
        tm.format = string.join({"%Y";"%m";"%d"},separator);
        return tostring(tm);
    }

    // 新增：将日期字符串、time对象或Excel日期统一转换为 Excel 标准日期序列值(OLE Date数值)
    var toExcelDate = function(v){
        if(!v || v === "") return tonumber(time.ole(time.now())); // 为空则默认取今天
        if(type(v) == "number") return v; // 已经是 Excel 日期序列值则直接返回
        if(time.istime(v)) return tonumber(time.ole(v));

        var s = string.trim(tostring(v));
        if(!#s) return tonumber(time.ole(time.now()));

        // 兼容 "2026.10.20"、"2026-10-20"、"2026/10/20" 等常见填写格式
        s = string.replace(s, "[\.\-]", "/");
        var ok, tm = call(time, null, s, "%Y/%m/%d");
        if(ok && tm) return tonumber(time.ole(tm));

        return v; // 无法解析的特殊文本原样保留
    }

    import string.keywords;
    _plastics = 'PC|PVC|PS|PP|ABS|夜帘|橡胶';
    _glass = '玻璃|钢化玻璃|有机玻璃';
    _glass_sys = '钢化玻璃|钢化玻璃|有机玻璃';
    _metal_sys = '铝合金|不锈钢板|焊接件|焊接件';
    _metal = '铝合金|不锈钢|焊接件|铆接件';
    _cooper = '管|TP2M|蒸发器|冷凝器|阀';
    _cooper_sys = '铜管|铜管|蒸发器|冷凝器|阀';

    winform.listview.clear(true);
    winform.listview.addItem(sht.parent.name);

    // ================= 阶段一：逐行分析与填充数据 =================
    for(i=1; etab_count){
        bar.pos = i;
        // 每隔 15 行刷新一次进度文本并让出界面消息泵，既保证界面绝对流畅，又不拖慢循环速度
        if(i % 15 == 0 || i == etab_count){
            bar.text = string.format("正在分析物料数据: %d / %d (%d%%)", i, etab_count, bar.pos);
            win.delay(1);
        }

        for(j=1; maxCol)
            if !etab[i][j] etab[i][j] = "";  // EXCEL SAFE ARRAY
        if !string.len(etab[i][findCol("物料描述")]) continue;

        if !#etab[i][findCol("销售组织")] etab[i][findCol("销售组织")] = "CN10";
        if !#etab[i][findCol("申请人")] etab[i][findCol("申请人")] = username;
        // 修改这里：无论原本是否为空，统一转换为 Excel 标准日期数值
        etab[i][findCol("申请日期")] = toExcelDate(etab[i][findCol("申请日期")]);
        if !#etab[i][findCol("基本计量单位")] etab[i][findCol("基本计量单位")] = "ZA";
        if !#etab[i][findCol("产品大类")] etab[i][findCol("产品大类")] = "柜体";
        if !#etab[i][findCol("用途")] etab[i][findCol("用途")] = "新品BOM";

        var str = etab[i][findCol("物料描述")];

        var ePush = function(val, index){
            index := {findCol("物料类型"),findCol("采购类型"),findCol("P11物料组"),findCol("物料分类明细"),findCol("材质分类"), findCol("是否关键部件")};
            for(k=1; #index)
                if !#etab[i][index[k]] etab[i][index[k]] = val[k];
        }   

        if string.keywords('可选项').findOne(str)
            ePush({"KMAT","E","SG","09","可选项","否"});
        elseif string.keywords('总装|组装').findOne(str)
            ePush({"HALB","E","SG","08","总装","否"});
        elseif string.keywords('组件').findOne(str)   
            ePush({"HALB","E","SA","08","总装","否"});
        elseif string.keywords('已喷').findOne(str)   
            ePush({"HALB","E","SC","11","喷粉件","否"});
        elseif string.keywords('玻璃门').findOne(str)    
            ePush({"HALB","F","R08","08","玻璃门","否"});       
        elseif string.keywords(_plastics).findOne(str)
            ePush({"HALB","F","R02","02", string.split(_plastics,"|")[string.keywords(_plastics).findOne(str)],"否"});
        elseif string.keywords('亚克力|EPS|尼龙|GFRP|GFK').findOne(str)
            ePush({"HALB","F","R02","02","其他塑料件","否"});
        elseif string.keywords('底箱体|发泡板|发泡箱体|发泡预装').findOne(str)
            ePush({"HALB","E","SD","08","发泡","否"});
        elseif string.keywords(_glass).findOne(str)     
            ePush({"HALB","F","R14","14", string.split(_glass_sys,"|")[string.keywords(_glass).findOne(str)],"否"});
        elseif string.keywords('点焊').findOne(str)
            ePush({"HALB","E","SH","11","焊接件","否"});
        elseif string.keywords(_metal).findOne(str)
            ePush({"HALB","F","R01","11", string.split(_metal_sys,"|")[string.keywords(_metal).findOne(str)],"否"});
        elseif string.keywords('木包装').findOne(str)
            ePush({"HALB","F","R15","16","木包装","否"});
        elseif string.keywords('板|连接件|支撑|未喷').findOne(str)
            ePush({"HALB","E","SB","11","钣金","否"});
        elseif string.keywords(_cooper).findOne(str)
            ePush({"HALB","F","R07","07",string.split(_cooper_sys,"|")[string.keywords(_cooper).findOne(str)],"否"});
    }

    // ================= 阶段二：已喷未喷对应关系分组 =================
    bar.text = "正在计算已喷/未喷对应关系分组...";
    win.delay(1);

    var colDesc = findCol("物料描述");
    var colSpray = findCol("已喷未喷对应关系");
    var sprayGroups = {};
    var sprayOrder = {};

    for(i = 1; etab_count) {
        var desc = etab[i][colDesc];
        if(!#desc) continue;

        var isSprayed = string.indexOf(desc, "已喷");
        var isUnsprayed = string.indexOf(desc, "未喷");

        if(isSprayed || isUnsprayed) {
            var baseKey = string.replace(desc, "<已喷>|<未喷>.*$", "");
            baseKey = string.trim(baseKey, ' \t-_()/（）');

            if(#baseKey) {
                if(!sprayGroups[baseKey]) {
                    sprayGroups[baseKey] = { rows = {}; hasSprayed = false; hasUnsprayed = false };
                    table.push(sprayOrder, baseKey);
                }
                table.push(sprayGroups[baseKey].rows, i);
                if(isSprayed) sprayGroups[baseKey].hasSprayed = true;
                if(isUnsprayed) sprayGroups[baseKey].hasUnsprayed = true;
            }
        }
    }

    var groupId = 0;
    for(k = 1; #sprayOrder) {
        var key = sprayOrder[k];
        var grp = sprayGroups[key];
        if(grp.hasSprayed && grp.hasUnsprayed) {
            groupId++;
            for( _, rowIdx in grp.rows) {
                if(!#tostring(etab[rowIdx][colSpray])) {
                    etab[rowIdx][colSpray] = groupId;
                }
            }
        }
    }

    // ================= 阶段三：按列回写 Excel =================
    var skipCols = ["序号", "长度检查", "属性", "S4物料组"];

    // 写入期间暂时关闭 Excel 屏幕刷新与公式自动重算，速度提升数倍且不会闪烁
    excel_2.ScreenUpdating = false;

    for(col = 1; maxCol) {
        var colName = fieldName[col];
        if(table.find(skipCols, colName)) continue;

        // 更新进度条与实时列名称状态
        bar.pos = etab_count + math.floor((col / maxCol) * writeSteps);
        bar.text = string.format("正在写入列 [%s] (%d%%)...", colName, bar.pos);
        win.delay(1); // 保持按钮旋转动画与界面响应

        var colData = {};
        for(row = 1; etab_count) {
            colData[row] = [ etab[row][col] ];
        }

        var colLetter = etip.toColName(col);
        var targetRng = sht.Range(colLetter ++ "3:" ++ colLetter ++ lastRow);
        targetRng.Value2 = colData;

        // 新增：如果是申请日期列，设置为标准的 Excel 日期显示格式
        if(colName == "申请日期"){
            targetRng.NumberFormatLocal = "yyyy/m/d"; // 也可按需改为 "yyyy-mm-dd"
        }
    }

    excel_2.ScreenUpdating = true;
    bar.pos = totalSteps;

    // 复制处理后的文件名到剪贴板
    var filename = sht.parent.name;
    filename = string.replace(filename, "姓名", username);
    filename = string.replace(filename, "日期", str_today("."));

    import win.clip;
    win.clip.write(string.left(filename,#filename-1));

    // 恢复按钮与窗口状态
    cleanUp(string.format("✓ 处理完成！共处理 %d 行，已喷/未喷配对 %d 组", etab_count, groupId));
}

/*点击定位{{*/
winform.listview.onSelChanged = function(selected,item,subItem,nmListView){
	if !selected return ; 
	if !item return ;
	var row = owner.getItemText(item,1);
	if !row return ; 
	sht = domisoft.getRunningWorkSheet(winform.combobox2.selText);
	if !sht return ; 
	excel_2 = sht.Parent.Application;
	excel_2.ActiveWindow.ScrollRow = row;
	sht = null;
	excel_2 = null;
	collectgarbage("collect");
}
/*}}*/

/*右键菜单{{*/
winform.listview.onnotify = function(id,code,ptr){
	select(code) {
    	case 0xFFFFFFFB/*_NM_RCLICK*/ {
    		var selectedRow = owner.getSelection();
    		if !selectedRow return ; 
			var x,y = win.getMessagePos();
		
			var menu = win.ui.popmenu(winform);			
			menu.add("隐藏可忽略项", function(){
				var t = table.filter(getErr,
					function(v,index){
						if v["错误描述"]
							return !string.indexOf(v["错误描述"], "可忽略"); 
					}
				);
				t.fields = getErr.fields;
				winform.listview.setTable(t);
			});
			menu.add("显示可忽略项", λ() winform.listview.setTable(getErr));
			menu.popup(x,y,true);
    	}
    }
}
/*}}*/
/* CTRLC复制模块 */
winform.listview.translateAccelerator = domisoft.ctrlC;
winform.combobox2.listBox.ellipsis = "path";
winform.show();
if !winform.parent
	win.setForeground(winform.hwnd);
if !winform.parent
	winform.frmReLoad();
winform.onClose = function(hwnd,message,wParam,lParam){
    publish("CleanHiddenExcel"); 
}


win.loopMessage();
return winform;